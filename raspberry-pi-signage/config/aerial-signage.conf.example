# aerial-signage configuration.
# Copy to /etc/aerial-signage/aerial-signage.conf and edit for your display.

# --- Clock overlay ---
AERIAL_CLOCK_ENABLED=1
# Minutes added to real time. Can be negative, e.g. -540.
AERIAL_CLOCK_OFFSET_MINUTES=0
# 24h | 12h | custom
AERIAL_CLOCK_FORMAT=24h
# 1=show seconds
AERIAL_CLOCK_SECONDS=0
# 1=hide AM/PM, only relevant for 12h
AERIAL_CLOCK_HIDE_AMPM=0
# strftime format used only when AERIAL_CLOCK_FORMAT=custom
AERIAL_CLOCK_CUSTOM_FORMAT=%H:%M
# topLeft | topCenter | topRight | bottomLeft | bottomCenter | bottomRight | left | right | screenCenter | random
AERIAL_CLOCK_CORNER=bottomLeft
# ASS font size at a 1920x1080 reference resolution
AERIAL_CLOCK_FONT_SIZE=50
# Optional font family name. Empty uses mpv default.
AERIAL_CLOCK_FONT=
# Pixel margin from screen edges at a 1920x1080 reference resolution
AERIAL_CLOCK_MARGIN=60
# RRGGBB text color. Lua converts this to ASS BGR internally.
AERIAL_CLOCK_COLOR=FFFFFF

# --- Date overlay ---
AERIAL_DATE_ENABLED=0
AERIAL_DATE_CORNER=bottomLeft
AERIAL_DATE_FONT_SIZE=25
AERIAL_DATE_FONT=
AERIAL_DATE_COLOR=FFFFFF
AERIAL_DATE_MARGIN=60
# textual | compact | numeric | custom
AERIAL_DATE_FORMAT=textual
# strftime format used only when AERIAL_DATE_FORMAT=custom
AERIAL_DATE_CUSTOM_FORMAT=%Y-%m-%d
# 1=include year. Numeric format always includes year.
AERIAL_DATE_WITH_YEAR=0
# ja | en
AERIAL_DATE_LANG=ja

# --- Location overlay ---
AERIAL_LOC_ENABLED=0
AERIAL_LOC_CORNER=topRight
AERIAL_LOC_FONT_SIZE=28
AERIAL_LOC_FONT=
AERIAL_LOC_COLOR=FFFFFF
AERIAL_LOC_MARGIN=60
# accessibilityLabel | name | poi | filename
AERIAL_LOC_MODE=accessibilityLabel
AERIAL_LABELS_FILE=/var/lib/aerial-signage/labels.tsv

# --- Message overlay ---
AERIAL_MSG_ENABLED=0
AERIAL_MSG_CORNER=bottomRight
AERIAL_MSG_FONT_SIZE=24
AERIAL_MSG_FONT=
AERIAL_MSG_COLOR=FFFFFF
AERIAL_MSG_MARGIN=60
# Use literal \n for line breaks; values containing spaces must be quoted.
AERIAL_MSG_TEXT="Studio Vibes Wi-Fi\nSSID : fcm-dkym-booth\nPW : dkymfcm117"

# --- Video source ---
# 1080-sdr | 1080-hdr | 4k-sdr | 4k-hdr | 1080-h264
# HEVC is the default because both Pi 4 and Pi 5 hardware-decode 4K HEVC.
AERIAL_QUALITY=1080-sdr
# classic63 | tvos16 | community. tvos16 ships with a placeholder URL in
# manifest/sources.json and must be filled by orchestration before use.
AERIAL_SOURCE=classic63
# Back-compat override. If changed from this default, it wins over AERIAL_SOURCE.
AERIAL_MANIFEST_URL=https://raw.githubusercontent.com/kopiro/xscreensaver-apple-aerial/main/entries.json
AERIAL_CACHE_DIR=/var/lib/aerial-signage/videos
AERIAL_PLAYLIST=/var/lib/aerial-signage/playlist.txt
# 0=all, N=only first N to save disk during setup
AERIAL_VIDEO_LIMIT=0
# 1=only download the exact AERIAL_QUALITY variant and never fall back to another
# codec. Set to 1 on Raspberry Pi 3 together with AERIAL_QUALITY=1080-h264,
# because Pi 3 has no HEVC hardware decode and cannot play the HEVC fallbacks.
AERIAL_STRICT_QUALITY=0
# Empty = all scenes. Otherwise comma-separated:
# countryside,nature,city,beach,sea,space,other
AERIAL_SCENES=
# Comma-separated asset ids hidden from playlist generation.
AERIAL_HIDDEN_VIDEOS=
AERIAL_SHUFFLE=1

# --- mpv / display ---
# gpu is the safe default. On a real Pi 4 (Trixie/mpv 0.40) the gpu renderer
# could only present ~15 fps; gpu-next is fast BUT cannot sample the Pi's
# tiled 10-bit HEVC frames (solid purple screen). The proven smooth combo on
# Pi 4 is: AERIAL_QUALITY=1080-h264 + AERIAL_STRICT_QUALITY=1 +
# AERIAL_MPV_VO=gpu-next + AERIAL_MPV_HWDEC=v4l2m2m-copy +
# AERIAL_MPV_EXTRA="--drm-mode=1920x1080 --video-sync=display-resample"
# (see README "Performance tuning").
AERIAL_MPV_VO=gpu
# drm on a Pi console; set auto to test on a desktop or macOS.
AERIAL_MPV_GPU_CONTEXT=drm
# drm-copy for HEVC hardware decode on Pi; v4l2m2m-copy for H.264;
# set auto for desktop testing.
AERIAL_MPV_HWDEC=drm-copy
# Extra raw mpv flags. Keep paths without spaces; the launcher parses this as words.
# On a 4K display add: --drm-mode=1920x1080 (let the TV upscale; the Pi 4 GPU
# cannot shader-upscale 1080p->4K in realtime). --video-sync=display-resample
# locks presentation to the display for judder-free 29.97fps on a 60Hz mode.
AERIAL_MPV_EXTRA=
