def login_page() -> str:
    return """<!doctype html><html><head><meta charset="utf-8"><title>Aerial Login</title></head><body><form method="get"><input name="token" type="password" autofocus><button>Login</button></form></body></html>"""


class Handler(BaseHTTPRequestHandler):
    server_version = "aerial-web/1"

    def log_message(self, fmt: str, *args: Any) -> None:
        print(fmt % args, file=sys.stderr)

    def supplied_token(self) -> Optional[str]:
        parsed = urllib.parse.urlparse(self.path)
        query = urllib.parse.parse_qs(parsed.query)
        if query.get("token"):
            return query["token"][0]
        cookie = http.cookies.SimpleCookie(self.headers.get("Cookie", ""))
        morsel = cookie.get("aerial_token")
        return morsel.value if morsel else None

    def require_auth(self) -> bool:
        expected = os.environ.get("AERIAL_WEB_TOKEN", "")
        if not expected:
            return True
        supplied = self.supplied_token()
        if token_matches(expected, supplied):
            return True
        self.send_html(login_page(), HTTPStatus.UNAUTHORIZED)
        return False

    def read_json(self) -> Dict[str, Any]:
        length = int(self.headers.get("Content-Length", "0"))
        data = self.rfile.read(length) if length else b"{}"
        payload = json.loads(data.decode("utf-8"))
        if not isinstance(payload, dict):
            raise ValueError("JSON body must be an object")
        return payload

    def send_json(self, payload: Dict[str, Any], status: HTTPStatus = HTTPStatus.OK) -> None:
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def send_html(self, payload: str, status: HTTPStatus = HTTPStatus.OK) -> None:
        data = payload.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        if token_matches(os.environ.get("AERIAL_WEB_TOKEN", ""), self.supplied_token()):
            self.send_header("Set-Cookie", f"aerial_token={self.supplied_token()}; Path=/; SameSite=Strict")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self) -> None:
        if not self.require_auth():
            return
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/":
            self.send_html(html_page())
        elif parsed.path == "/api/state":
            self.send_json(api_state())
        elif parsed.path == "/api/videos":
            self.send_json(api_videos())
        elif parsed.path == "/api/profiles":
            self.send_json(list_profiles())
        elif parsed.path == "/api/export-settings":
            self.send_json({"ok": True, "config": export_windows_config_json(parse_key_value_config(config_path()))})
        else:
            self.send_json({"error": "not found"}, HTTPStatus.NOT_FOUND)

    def do_POST(self) -> None:
        if not self.require_auth():
            return
        parsed = urllib.parse.urlparse(self.path)
        try:
            if parsed.path == "/api/save":
                payload = self.read_json()
                cfg = payload.get("config")
                if not isinstance(cfg, dict):
                    raise ValueError("config must be an object")
                self.send_json(save_config_and_restart(cfg))
            elif parsed.path == "/api/fetch":
                self.send_json(start_cmd([SYSTEMCTL, "start", "aerial-fetch.service"]))
            elif parsed.path == "/api/player/restart":
                self.send_json(restart_player())
            elif parsed.path == "/api/import-display-settings":
                payload = self.read_json()
                plist_text = payload.get("plist")
                if not isinstance(plist_text, str):
                    raise ValueError("plist must be a string")
                self.send_json(import_display_settings_plist(plist_text))
            elif parsed.path == "/api/import-windows-settings":
                payload = self.read_json()
                config_text = payload.get("config")
                if not isinstance(config_text, str):
                    raise ValueError("config must be a string")
                self.send_json(import_windows_config_json(config_text))
            elif parsed.path == "/api/profiles/save":
                payload = self.read_json()
                name = payload.get("name")
                cfg = payload.get("config")
                if not isinstance(name, str) or not isinstance(cfg, dict):
                    raise ValueError("name and config are required")
                self.send_json(save_profile(name, cfg))
            elif parsed.path == "/api/profiles/load":
                payload = self.read_json()
                name = payload.get("name")
                if not isinstance(name, str):
                    raise ValueError("name is required")
                self.send_json(load_profile(name))
            elif parsed.path == "/api/profiles/delete":
                payload = self.read_json()
                name = payload.get("name")
                if not isinstance(name, str):
                    raise ValueError("name is required")
                self.send_json(delete_profile(name))
            elif parsed.path == "/api/reboot":
                self.send_json(start_cmd([SYSTEMCTL, "reboot"]))
            else:
                self.send_json({"error": "not found"}, HTTPStatus.NOT_FOUND)
        except (ValueError, json.JSONDecodeError) as exc:
            self.send_json({"error": str(exc)}, HTTPStatus.BAD_REQUEST)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Aerial Signage Web UI")
    parser.add_argument("--port", type=int, default=int(os.environ.get("AERIAL_WEB_PORT", "8080")))
    return parser


def main(argv: Optional[List[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    server = ThreadingHTTPServer(("0.0.0.0", args.port), Handler)
    print(f"aerial-web listening on 0.0.0.0:{args.port}", file=sys.stderr)
    thread = threading.current_thread()
    thread.name = "aerial-web-main"
    server.serve_forever()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
