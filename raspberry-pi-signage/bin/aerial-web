# See docs/display-settings-mapping.md for the authoritative spec/Windows/env table.
SPEC_CORNER_TO_ENV = {
    0: "topLeft",
    1: "topCenter",
    2: "topRight",
    3: "bottomLeft",
    4: "bottomCenter",
    5: "bottomRight",
    6: "screenCenter",
    7: "random",
    8: "absTopRight",
}
WINDOWS_CORNER_TO_ENV = {
    "topleft": "topLeft",
    "topmiddle": "topCenter",
    "topright": "topRight",
    "bottomleft": "bottomLeft",
    "bottommiddle": "bottomCenter",
    "bottomright": "bottomRight",
    "middle": "screenCenter",
    "left": "left",
    "right": "right",
    "random": "random",
}
SPEC_CLOCK_FORMAT_TO_ENV = {0: "24h", 1: "24h", 2: "12h", 3: "custom"}
SPEC_DATE_FORMAT_TO_ENV = {0: "textual", 1: "compact", 2: "custom"}


def script_root() -> Path:
    return Path(__file__).resolve().parent.parent


def config_path() -> Path:
    return Path(os.environ.get("AERIAL_CONFIG", DEFAULT_CONFIG))


def bool01(value: Any) -> str:
    if isinstance(value, bool):
        return "1" if value else "0"
    return "1" if str(value).strip().lower() in {"1", "true", "yes", "on"} else "0"


def normalize_config_payload(config: Dict[str, Any]) -> Dict[str, str]:
    normalized: Dict[str, str] = {}
    for key, value in config.items():
        if key not in KNOWN_KEYS:
            continue
        if isinstance(value, list):
            normalized[key] = ",".join(str(item).strip() for item in value if str(item).strip())
        elif key.endswith("_ENABLED") or key in {
            "AERIAL_CLOCK_SECONDS",
            "AERIAL_CLOCK_HIDE_AMPM",
            "AERIAL_DATE_WITH_YEAR",
            "AERIAL_STRICT_QUALITY",
            "AERIAL_SHUFFLE",
        }:
            normalized[key] = bool01(value)
        else:
            normalized[key] = str(value)
    return normalized


def effective_config(cfg: Dict[str, str]) -> Dict[str, str]:
    effective = dict(WEB_DEFAULTS)
    effective.update(cfg)
    return effective


def quote_config_value(value: str) -> str:
    value = value.replace("\r\n", "\n").replace("\r", "\n").replace("\n", r"\n")
    if '"' in value:
        raise ValueError("double quotes are not supported in config values")
    if re.search(r"[`;&|<>]", value):
        raise ValueError("unsupported shell metacharacter in config value")
    if re.search(r"\s", value) or value == "":
        return f'"{value}"'
    if "'" in value:
        raise ValueError("single quotes are not supported in unquoted config values")
    return value


def format_config_line(key: str, value: str) -> str:
    if key not in KNOWN_KEYS or not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", key):
        raise ValueError(f"unknown or invalid config key: {key}")
    line = f"{key}={quote_config_value(value)}"
    validate_config_line(line)
    return line


def validate_config_line(line: str) -> None:
    if not VALID_ASSIGN_RE.match(line) or "$(" in line or "`" in line:
        raise ValueError(f"invalid config line: {line}")


def rewrite_config_text(original: str, updates: Dict[str, str]) -> str:
    normalized = normalize_config_payload(updates)
    seen = set()
    output: List[str] = []
    for raw_line in original.splitlines():
        match = CONFIG_LINE_RE.match(raw_line.strip())
        if match and match.group(1) in normalized:
            key = match.group(1)
            output.append(format_config_line(key, normalized[key]))
            seen.add(key)
        else:
            output.append(raw_line)
    missing = [key for key in normalized if key not in seen]
    if missing:
        if output and output[-1].strip():
            output.append("")
        output.append("# Managed by aerial-web")
        for key in missing:
            output.append(format_config_line(key, normalized[key]))
    return "\n".join(output) + "\n"


def write_config_file(path: Path, updates: Dict[str, str]) -> None:
    original = path.read_text(encoding="utf-8") if path.exists() else ""
    rewritten = rewrite_config_text(original, updates)
    for line in rewritten.splitlines():
        stripped = line.strip()
        if stripped and not stripped.startswith("#") and CONFIG_LINE_RE.match(stripped):
            validate_config_line(stripped)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_suffix(path.suffix + ".part")
    tmp_path.write_text(rewritten, encoding="utf-8")
    tmp_path.replace(path)


def token_matches(expected: str, supplied: Optional[str]) -> bool:
    return bool(expected) and supplied is not None and hmac.compare_digest(expected, supplied)


def load_sources() -> List[Dict[str, Any]]:
    path = script_root() / "manifest" / "sources.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    if not isinstance(data, dict) or not isinstance(data.get("sources"), list):
        return []
    return [item for item in data["sources"] if isinstance(item, dict)]


def parse_key_value_config(path: Path) -> Dict[str, str]:
    values: Dict[str, str] = {}
    if not path.exists():
        return values
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        match = CONFIG_LINE_RE.match(line)
        if not match:
            continue
        key, value = match.group(1), match.group(2).strip()
        if value[:1] in {"'", '"'}:
            quote = value[0]
            end = value.find(quote, 1)
            if end == -1:
                continue
            value = value[1:end]
        else:
            value = re.split(r"\s#", value, maxsplit=1)[0].strip()
        values[key] = value
    return values


def run_cmd(args: List[str], timeout: int = 15) -> Dict[str, Any]:
    try:
        proc = subprocess.run(args, text=True, capture_output=True, timeout=timeout, check=False)
        return {"ok": proc.returncode == 0, "returncode": proc.returncode, "stdout": proc.stdout, "stderr": proc.stderr}
    except Exception as exc:  # noqa: BLE001 - API returns errors as JSON.
        return {"ok": False, "returncode": None, "stdout": "", "stderr": str(exc)}


def start_cmd(args: List[str]) -> Dict[str, Any]:
    try:
        subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {"ok": True}
    except Exception as exc:  # noqa: BLE001
        return {"ok": False, "error": str(exc)}


def playlist_count(cfg: Dict[str, str]) -> int:
    playlist = Path(cfg.get("AERIAL_PLAYLIST", "/var/lib/aerial-signage/playlist.txt"))
    if not playlist.exists():
        return 0
    return len([line for line in playlist.read_text(encoding="utf-8", errors="ignore").splitlines() if line.strip()])


def rebuild_playlist() -> Dict[str, Any]:
    fetch_path = script_root() / "bin" / "aerial-fetch"
    return run_cmd(["python3", str(fetch_path), "--config", str(config_path())], timeout=150)


def restart_player() -> Dict[str, Any]:
    return run_cmd([SYSTEMCTL, "restart", "aerial-signage.service"], timeout=20)


def save_config_and_restart(cfg: Dict[str, Any]) -> Dict[str, Any]:
    write_config_file(config_path(), cfg)
    fetch = rebuild_playlist()
    current_cfg = parse_key_value_config(config_path())
    count = playlist_count(current_cfg)
    systemctl = restart_player()
    return {"ok": systemctl["ok"], "systemctl": systemctl, "fetch": fetch, "playlist_count": count}


def _recv_mpv_line(client: socket.socket, deadline: float) -> Dict[str, Any]:
    chunks: List[bytes] = []
    while time.monotonic() < deadline:
        client.settimeout(max(0.01, deadline - time.monotonic()))
        chunk = client.recv(4096)
        if not chunk:
            break
        chunks.append(chunk)
        if b"\n" in chunk:
            break
    line = b"".join(chunks).split(b"\n", 1)[0]
    return json.loads(line.decode("utf-8", "replace"))


def query_mpv_stats(sock_path: str = "/tmp/mpvsock") -> Dict[str, Any]:
    if not os.path.exists(sock_path):
        return {}
    stats: Dict[str, Any] = {}
    commands = {
        "est_display_fps": ["get_property", "estimated-display-fps"],
        "drops": ["get_property", "frame-drop-count"],
    }
    deadline = time.monotonic() + 1.0
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(1.0)
            client.connect(sock_path)
            for key, command in commands.items():
                if time.monotonic() >= deadline:
                    return {}
                client.sendall((json.dumps({"command": command}) + "\n").encode("utf-8"))
                payload = _recv_mpv_line(client, deadline)
                if payload.get("error") != "success":
                    return {}
                value = payload.get("data")
                if key == "est_display_fps":
                    stats[key] = round(float(value), 1)
                else:
                    stats[key] = int(value)
    except Exception:  # noqa: BLE001 - status should never fail because mpv IPC is unavailable.
        return {}
    return stats


def system_status(cfg: Dict[str, str]) -> Dict[str, Any]:
    service = run_cmd([SYSTEMCTL, "is-active", "aerial-signage.service"], timeout=5)
    state_dir = Path(cfg.get("AERIAL_PLAYLIST", "/var/lib/aerial-signage/playlist.txt")).parent
    try:
        disk = shutil.disk_usage(state_dir if state_dir.exists() else "/")
        disk_info = {"total": disk.total, "used": disk.used, "free": disk.free}
    except OSError:
        disk_info = {"total": 0, "used": 0, "free": 0}
    status = {
        "service_active": service["ok"] and service["stdout"].strip() == "active",
        "service_raw": service["stdout"].strip() or service["stderr"].strip(),
        "disk": disk_info,
        "playlist_count": playlist_count(cfg),
    }
    mpv_stats = query_mpv_stats()
    if mpv_stats:
        status["mpv"] = mpv_stats
    return status


def api_state() -> Dict[str, Any]:
    cfg = effective_config(parse_key_value_config(config_path()))
    return {"config": cfg, "sources": load_sources(), "status": system_status(cfg)}


def api_videos() -> Dict[str, Any]:
    fetch_path = script_root() / "bin" / "aerial-fetch"
    cfg = effective_config(parse_key_value_config(config_path()))
    args = [
        "python3",
        str(fetch_path),
        "--config",
        str(config_path()),
        "--source",
        cfg["AERIAL_SOURCE"],
        "--quality",
        cfg["AERIAL_QUALITY"],
        "--manifest-url",
        cfg["AERIAL_MANIFEST_URL"],
        "--cache-dir",
        cfg["AERIAL_CACHE_DIR"],
        "--limit",
        cfg["AERIAL_VIDEO_LIMIT"],
        "--scenes",
        cfg["AERIAL_SCENES"],
        "--hidden-videos",
        cfg["AERIAL_HIDDEN_VIDEOS"],
        "--strict-quality" if bool01(cfg["AERIAL_STRICT_QUALITY"]) == "1" else "--no-strict-quality",
        "--list-videos",
    ]
    result = run_cmd(args, timeout=60)
    videos = []
    if result["ok"]:
        reader = csv.reader(result["stdout"].splitlines(), delimiter="\t")
        for row in reader:
            if len(row) >= 5:
                videos.append(
                    {
                        "id": row[0],
                        "scene": row[1],
                        "label": row[2],
                        "has_h264": row[3] == "1",
                        "cached": row[4] == "1",
                    }
                )
    return {"ok": result["ok"], "videos": videos, "error": result["stderr"]}


def _json_dict(raw: Any) -> Optional[Dict[str, Any]]:
    if not isinstance(raw, str):
        return None
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return None
    return payload if isinstance(payload, dict) else None


def _json_list(raw: Any) -> Optional[List[Any]]:
    if not isinstance(raw, str):
        return None
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return None
    return payload if isinstance(payload, list) else None


def _bool_string(raw: Any) -> Optional[str]:
    if isinstance(raw, bool):
        return "1" if raw else "0"
    return None


def _number_string(raw: Any) -> Optional[str]:
    if isinstance(raw, (int, float)):
        return str(int(raw))
    return None


def normalize_corner_value(raw: Any) -> Optional[str]:
    if isinstance(raw, (int, float)):
        return SPEC_CORNER_TO_ENV.get(int(raw))
    if isinstance(raw, str):
        return SPEC_CORNER_TO_ENV.get(int(raw)) if raw.isdigit() else WINDOWS_CORNER_TO_ENV.get(raw, raw)
    return None


def translate_datetime_format(raw: str) -> str:
    if "%" in raw:
        return raw
    replacements = {
        "yyyy": "%Y",
        "YYYY": "%Y",
        "yy": "%y",
        "YY": "%y",
        "MMMM": "%B",
        "MMM": "%b",
        "MM": "%m",
        "M": "%m",
        "dd": "%d",
        "DD": "%d",
        "d": "%d",
        "D": "%d",
        "EEEE": "%A",
        "EEE": "%a",
        "HH": "%H",
        "H": "%H",
        "hh": "%I",
        "h": "%I",
        "mm": "%M",
        "m": "%M",
        "ss": "%S",
        "s": "%S",
        "a": "%p",
        "A": "%p",
    }
    tokens = sorted(replacements, key=len, reverse=True)
    out: List[str] = []
    i = 0
    while i < len(raw):
        for token in tokens:
            if raw.startswith(token, i):
                out.append(replacements[token])
                i += len(token)
                break
        else:
            out.append(raw[i])
            i += 1
    return "".join(out)


def apple_reference_seconds_to_unix(raw: Any) -> Optional[float]:
    if not isinstance(raw, (int, float)):
        return None
    return 978307200 + float(raw)


def import_display_settings_plist(plist_text: str) -> Dict[str, Any]:
    try:
        payload = plistlib.loads(plist_text.encode("utf-8"))
    except Exception as exc:  # noqa: BLE001 - API reports parse failures as JSON.
        raise ValueError(f"invalid plist: {exc}") from exc
    if not isinstance(payload, dict):
        raise ValueError("plist root must be a dictionary")

    updates: Dict[str, Any] = {}
    imported_keys: List[str] = []
    skipped_keys: List[str] = []

    def add(key: str, value: Any, source: str) -> None:
        if value is None:
            skipped_keys.append(source)
            return
        candidate = normalize_config_payload({key: value})
        if not candidate:
            skipped_keys.append(source)
            return
        try:
            format_config_line(key, candidate[key])
        except ValueError:
            skipped_keys.append(source)
            return
        updates[key] = candidate[key]
        imported_keys.append(source)

    if isinstance(payload.get("customTimeFormat"), str):
        add("AERIAL_CLOCK_CUSTOM_FORMAT", translate_datetime_format(payload["customTimeFormat"]), "customTimeFormat")
    if isinstance(payload.get("customDateFormat"), str):
        add("AERIAL_DATE_CUSTOM_FORMAT", translate_datetime_format(payload["customDateFormat"]), "customDateFormat")

    layer_keys = _json_list(payload.get("layers"))
    if layer_keys is not None:
        imported_keys.append("layers")

    layer_map = {
        "LayerClock": "AERIAL_CLOCK",
        "LayerDate": "AERIAL_DATE",
        "LayerMessage": "AERIAL_MSG",
        "LayerLocation": "AERIAL_LOC",
    }
    for plist_key, prefix in layer_map.items():
        layer = _json_dict(payload.get(plist_key))
        if layer is None:
            if plist_key in payload:
                skipped_keys.append(plist_key)
            continue
        enabled = _bool_string(layer.get("isEnabled"))
        if enabled is not None:
            add(f"{prefix}_ENABLED", enabled, f"{plist_key}.isEnabled")
        corner = normalize_corner_value(layer.get("corner"))
        if corner is not None:
            add(f"{prefix}_CORNER", corner, f"{plist_key}.corner")
        font_size = _number_string(layer.get("fontSize"))
        if font_size is not None:
            add(f"{prefix}_FONT_SIZE", font_size, f"{plist_key}.fontSize")
        if isinstance(layer.get("fontName"), str):
            add(f"{prefix}_FONT", layer["fontName"], f"{plist_key}.fontName")

        if plist_key == "LayerClock":
            if "showSeconds" in layer:
                add("AERIAL_CLOCK_SECONDS", _bool_string(layer.get("showSeconds")), "LayerClock.showSeconds")
            if "hideAmPm" in layer:
                add("AERIAL_CLOCK_HIDE_AMPM", _bool_string(layer.get("hideAmPm")), "LayerClock.hideAmPm")
            fmt = layer.get("clockFormat")
            if isinstance(fmt, (int, float)) and int(fmt) in SPEC_CLOCK_FORMAT_TO_ENV:
                add("AERIAL_CLOCK_FORMAT", SPEC_CLOCK_FORMAT_TO_ENV[int(fmt)], "LayerClock.clockFormat")
        elif plist_key == "LayerDate":
            if "withYear" in layer:
                add("AERIAL_DATE_WITH_YEAR", _bool_string(layer.get("withYear")), "LayerDate.withYear")
            fmt = layer.get("format")
            if isinstance(fmt, (int, float)) and int(fmt) in SPEC_DATE_FORMAT_TO_ENV:
                add("AERIAL_DATE_FORMAT", SPEC_DATE_FORMAT_TO_ENV[int(fmt)], "LayerDate.format")
        elif plist_key == "LayerMessage":
            message_type = layer.get("messageType", 0)
            if message_type in (0, 0.0) and isinstance(layer.get("message"), str):
                add("AERIAL_MSG_TEXT", layer["message"], "LayerMessage.message")
        elif plist_key == "LayerLocation":
            add("AERIAL_LOC_MODE", "accessibilityLabel", "LayerLocation.mode")

    for key in ("LayerCountdown", "LayerTimer"):
        layer = _json_dict(payload.get(key))
        if layer:
            for date_key in ("targetDate", "triggerDate", "duration"):
                if date_key in layer and apple_reference_seconds_to_unix(layer[date_key]) is None:
                    skipped_keys.append(f"{key}.{date_key}")

    return {"ok": True, "config": updates, "imported_keys": imported_keys, "skipped_keys": skipped_keys}


def html_page() -> str:
    return r"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Aerial Config</title>
<style>
:root{color-scheme:dark;--bg:#171719;--panel:#242428;--panel2:#2d2d32;--text:#f4f4f5;--muted:#a6a6ad;--border:#3b3b42;--accent:#62a8ff;--good:#6cd17a;--warn:#ffcc66;--danger:#ff6b6b}
