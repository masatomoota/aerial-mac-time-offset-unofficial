def script_root() -> Path:
    return Path(__file__).resolve().parent.parent


def config_path() -> Path:
    return Path(os.environ.get("AERIAL_CONFIG", DEFAULT_CONFIG))


def bool01(value: Any) -> str:
    if isinstance(value, bool):
        return "1" if value else "0"
    return "1" if str(value).strip().lower() in {"1", "true", "yes", "on"} else "0"


def strftime_to_moment(raw: str) -> str:
    replacements = {
        "%Y": "YYYY",
        "%y": "YY",
        "%B": "MMMM",
        "%b": "MMM",
        "%m": "MM",
        "%d": "DD",
        "%A": "dddd",
        "%a": "ddd",
        "%H": "HH",
        "%I": "hh",
        "%M": "mm",
        "%S": "ss",
        "%p": "A",
    }
    out = str(raw)
    for source, target in replacements.items():
        out = out.replace(source, target)
    return out


def legacy_clock_moment_format(cfg: Dict[str, str]) -> str:
    if cfg.get("AERIAL_CLOCK_FORMAT") == "12h":
        seconds = ":ss" if cfg.get("AERIAL_CLOCK_SECONDS") == "1" else ""
        ampm = "" if cfg.get("AERIAL_CLOCK_HIDE_AMPM") == "1" else " A"
        return f"h:mm{seconds}{ampm}"
    if cfg.get("AERIAL_CLOCK_FORMAT") == "custom":
        return strftime_to_moment(cfg.get("AERIAL_CLOCK_CUSTOM_FORMAT", "%H:%M"))
    return "HH:mm:ss" if cfg.get("AERIAL_CLOCK_SECONDS") == "1" else "HH:mm"


def legacy_date_moment_format(cfg: Dict[str, str]) -> str:
    mode = cfg.get("AERIAL_DATE_FORMAT", "textual")
    if mode == "custom":
        return strftime_to_moment(cfg.get("AERIAL_DATE_CUSTOM_FORMAT", "%Y-%m-%d"))
    if mode in {"compact", "numeric"}:
        return "YYYY/MM/DD" if cfg.get("AERIAL_DATE_WITH_YEAR") == "1" or mode == "numeric" else "MM/DD"
    return "YYYY MMMM D dddd" if cfg.get("AERIAL_DATE_WITH_YEAR") == "1" else "MMMM D dddd"


def legacy_text_position(cfg: Dict[str, str]) -> str:
    for prefix, default in (
        ("AERIAL_CLOCK", "bottomLeft"),
        ("AERIAL_DATE", "bottomLeft"),
        ("AERIAL_LOC", "topRight"),
        ("AERIAL_MSG", "bottomRight"),
    ):
        if cfg.get(f"{prefix}_ENABLED") == "1":
            return cfg.get(f"{prefix}_CORNER", default)
    return "bottomLeft"


def apply_legacy_text_migration(cfg: Dict[str, str]) -> Dict[str, str]:
    migrated = dict(cfg)
    migrated["AERIAL_TEXT_POSITION"] = legacy_text_position(migrated)
    migrated["AERIAL_TEXT_FONT"] = migrated.get("AERIAL_CLOCK_FONT") or "Segoe UI"
    migrated["AERIAL_TEXT_SIZE"] = "2"
    migrated["AERIAL_TEXT_COLOR"] = migrated.get("AERIAL_CLOCK_COLOR") or "FFFFFF"
    migrated["AERIAL_TEXT_RANDOM_INTERVAL"] = "30"
    migrated["AERIAL_TEXT_MAX_WIDTH"] = "50"
    line_no = 1

    def set_line(line_type: str, line_format: str = "hh:mm:ss", text: str = "", info_mode: str = "poi") -> None:
        nonlocal line_no
        if line_no > 4:
            return
        prefix = f"AERIAL_LINE{line_no}"
        migrated[f"{prefix}_TYPE"] = line_type
        migrated[f"{prefix}_FORMAT"] = line_format
        migrated[f"{prefix}_TEXT"] = text
        migrated[f"{prefix}_INFO_MODE"] = info_mode
        migrated[f"{prefix}_USE_DEFAULT_FONT"] = "1"
        line_no += 1

    if migrated.get("AERIAL_CLOCK_ENABLED") == "1":
        set_line("timedate", legacy_clock_moment_format(migrated))
    if migrated.get("AERIAL_DATE_ENABLED") == "1":
        set_line("timedate", legacy_date_moment_format(migrated))
    if migrated.get("AERIAL_LOC_ENABLED") == "1":
        mode = migrated.get("AERIAL_LOC_MODE", "accessibilityLabel")
        set_line("videoname" if mode in {"videoName", "name"} else "information", info_mode=mode)
    if migrated.get("AERIAL_MSG_ENABLED") == "1":
        set_line("message", text=migrated.get("AERIAL_MSG_TEXT", ""))
    return migrated


def normalize_config_payload(config: Dict[str, Any]) -> Dict[str, str]:
    normalized: Dict[str, str] = {}
    for key, value in config.items():
        if key not in KNOWN_KEYS:
            continue
        if isinstance(value, list):
            normalized[key] = ",".join(str(item).strip() for item in value if str(item).strip())
        elif key.endswith("_ENABLED") or key in {
            "AERIAL_CLOCK_SECONDS",
            "AERIAL_CLOCK_HIDE_AMPM",
            "AERIAL_DATE_WITH_YEAR",
            "AERIAL_STRICT_QUALITY",
            "AERIAL_SHUFFLE",
            "AERIAL_LINE1_USE_DEFAULT_FONT",
            "AERIAL_LINE2_USE_DEFAULT_FONT",
            "AERIAL_LINE3_USE_DEFAULT_FONT",
            "AERIAL_LINE4_USE_DEFAULT_FONT",
        }:
            normalized[key] = bool01(value)
        else:
            normalized[key] = str(value)
    return normalized


def effective_config(cfg: Dict[str, str]) -> Dict[str, str]:
    has_new_text = any(key in cfg and cfg[key] != "" for key in FORM_SAVE_KEYS if key.startswith("AERIAL_TEXT_") or re.match(r"^AERIAL_LINE[1-4]_", key))
    effective = dict(WEB_DEFAULTS)
    for key, value in cfg.items():
        if value != "":
            effective[key] = value
    if not has_new_text:
        effective = apply_legacy_text_migration(effective)
    return effective


def save_config_updates(config: Dict[str, Any]) -> Tuple[Dict[str, str], Set[str]]:
    displayed = {key: value for key, value in config.items() if key in FORM_SAVE_KEYS}
    normalized = normalize_config_payload(displayed)
    sanitized: Dict[str, str] = {}
    removals: Set[str] = set()
    for key, value in normalized.items():
        if value == "":
            removals.add(key)
            continue
        if key in COLOR_KEYS:
            if not HEX_COLOR_RE.match(value):
                raise ValueError(f"{key} must be a 6-hex color")
            value = value.upper()
        sanitized[key] = value
    return sanitized, removals


def quote_config_value(value: str) -> str:
    value = value.replace("\r\n", "\n").replace("\r", "\n").replace("\n", r"\n")
    if '"' in value:
        raise ValueError("double quotes are not supported in config values")
    if re.search(r"[`;&|<>]", value):
        raise ValueError("unsupported shell metacharacter in config value")
    if re.search(r"\s", value) or value == "":
        return f'"{value}"'
    if "'" in value:
        raise ValueError("single quotes are not supported in unquoted config values")
    return value


def format_config_line(key: str, value: str) -> str:
    if key not in KNOWN_KEYS or not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", key):
        raise ValueError(f"unknown or invalid config key: {key}")
    line = f"{key}={quote_config_value(value)}"
    validate_config_line(line)
    return line


def validate_config_line(line: str) -> None:
    if not VALID_ASSIGN_RE.match(line) or "$(" in line or "`" in line:
        raise ValueError(f"invalid config line: {line}")


def rewrite_config_text(original: str, updates: Dict[str, str], remove_keys: Iterable[str] = ()) -> str:
    normalized = normalize_config_payload(updates)
    removals = set(remove_keys) - set(normalized)
    seen = set()
    output: List[str] = []
    for raw_line in original.splitlines():
        match = CONFIG_LINE_RE.match(raw_line.strip())
        if match and match.group(1) in normalized:
            key = match.group(1)
            output.append(format_config_line(key, normalized[key]))
            seen.add(key)
        elif match and match.group(1) in removals:
            continue
        else:
            output.append(raw_line)
    missing = [key for key in normalized if key not in seen]
    if missing:
        if output and output[-1].strip():
            output.append("")
        output.append("# Managed by aerial-web")
        for key in missing:
            output.append(format_config_line(key, normalized[key]))
    return "\n".join(output) + "\n"


def write_config_file(path: Path, updates: Dict[str, str], remove_keys: Iterable[str] = ()) -> None:
    original = path.read_text(encoding="utf-8") if path.exists() else ""
    rewritten = rewrite_config_text(original, updates, remove_keys)
    for line in rewritten.splitlines():
        stripped = line.strip()
        if stripped and not stripped.startswith("#") and CONFIG_LINE_RE.match(stripped):
            validate_config_line(stripped)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_suffix(path.suffix + ".part")
    tmp_path.write_text(rewritten, encoding="utf-8")
    tmp_path.replace(path)


def token_matches(expected: str, supplied: Optional[str]) -> bool:
    return bool(expected) and supplied is not None and hmac.compare_digest(expected, supplied)


def load_sources() -> List[Dict[str, Any]]:
    path = script_root() / "manifest" / "sources.json"
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    if not isinstance(data, dict) or not isinstance(data.get("sources"), list):
        return []
    return [item for item in data["sources"] if isinstance(item, dict)]


def parse_key_value_config(path: Path) -> Dict[str, str]:
    values: Dict[str, str] = {}
    if not path.exists():
        return values
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        match = CONFIG_LINE_RE.match(line)
        if not match:
            continue
        key, value = match.group(1), match.group(2).strip()
        if value[:1] in {"'", '"'}:
            quote = value[0]
            end = value.find(quote, 1)
            if end == -1:
                continue
            value = value[1:end]
        else:
            value = re.split(r"\s#", value, maxsplit=1)[0].strip()
        values[key] = value
    return values


def run_cmd(args: List[str], timeout: int = 15) -> Dict[str, Any]:
    try:
        proc = subprocess.run(args, text=True, capture_output=True, timeout=timeout, check=False)
        return {"ok": proc.returncode == 0, "returncode": proc.returncode, "stdout": proc.stdout, "stderr": proc.stderr}
    except Exception as exc:  # noqa: BLE001 - API returns errors as JSON.
        return {"ok": False, "returncode": None, "stdout": "", "stderr": str(exc)}


def start_cmd(args: List[str]) -> Dict[str, Any]:
    try:
        subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return {"ok": True}
    except Exception as exc:  # noqa: BLE001
        return {"ok": False, "error": str(exc)}


def playlist_count(cfg: Dict[str, str]) -> int:
    playlist = Path(cfg.get("AERIAL_PLAYLIST", "/var/lib/aerial-signage/playlist.txt"))
    if not playlist.exists():
        return 0
    return len([line for line in playlist.read_text(encoding="utf-8", errors="ignore").splitlines() if line.strip()])


def rebuild_playlist() -> Dict[str, Any]:
    fetch_path = script_root() / "bin" / "aerial-fetch"
    return run_cmd(["python3", str(fetch_path), "--config", str(config_path())], timeout=150)


def restart_player() -> Dict[str, Any]:
    return run_cmd([SYSTEMCTL, "restart", "aerial-signage.service"], timeout=20)


def save_config_and_restart(cfg: Dict[str, Any]) -> Dict[str, Any]:
    updates, removals = save_config_updates(cfg)
    write_config_file(config_path(), updates, removals)
    fetch = rebuild_playlist()
    current_cfg = parse_key_value_config(config_path())
    count = playlist_count(current_cfg)
    systemctl = restart_player()
    return {"ok": systemctl["ok"], "systemctl": systemctl, "fetch": fetch, "playlist_count": count}


def _recv_mpv_line(client: socket.socket, deadline: float) -> Dict[str, Any]:
    chunks: List[bytes] = []
    while time.monotonic() < deadline:
        client.settimeout(max(0.01, deadline - time.monotonic()))
        chunk = client.recv(4096)
        if not chunk:
            break
        chunks.append(chunk)
        if b"\n" in chunk:
            break
    line = b"".join(chunks).split(b"\n", 1)[0]
    return json.loads(line.decode("utf-8", "replace"))


def query_mpv_stats(sock_path: str = "/tmp/mpvsock") -> Dict[str, Any]:
    if not os.path.exists(sock_path):
        return {}
    stats: Dict[str, Any] = {}
    commands = {
        "est_display_fps": ["get_property", "estimated-display-fps"],
        "drops": ["get_property", "frame-drop-count"],
    }
    deadline = time.monotonic() + 1.0
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(1.0)
            client.connect(sock_path)
            for key, command in commands.items():
                if time.monotonic() >= deadline:
                    return {}
                client.sendall((json.dumps({"command": command}) + "\n").encode("utf-8"))
                payload = _recv_mpv_line(client, deadline)
                if payload.get("error") != "success":
                    return {}
                value = payload.get("data")
                if key == "est_display_fps":
                    stats[key] = round(float(value), 1)
                else:
                    stats[key] = int(value)
    except Exception:  # noqa: BLE001 - status should never fail because mpv IPC is unavailable.
        return {}
    return stats


def system_status(cfg: Dict[str, str]) -> Dict[str, Any]:
    service = run_cmd([SYSTEMCTL, "is-active", "aerial-signage.service"], timeout=5)
    state_dir = Path(cfg.get("AERIAL_PLAYLIST", "/var/lib/aerial-signage/playlist.txt")).parent
    try:
        disk = shutil.disk_usage(state_dir if state_dir.exists() else "/")
        disk_info = {"total": disk.total, "used": disk.used, "free": disk.free}
    except OSError:
        disk_info = {"total": 0, "used": 0, "free": 0}
    status = {
        "service_active": service["ok"] and service["stdout"].strip() == "active",
        "service_raw": service["stdout"].strip() or service["stderr"].strip(),
        "disk": disk_info,
        "playlist_count": playlist_count(cfg),
    }
    mpv_stats = query_mpv_stats()
    if mpv_stats:
        status["mpv"] = mpv_stats
    return status


def api_state() -> Dict[str, Any]:
    cfg = effective_config(parse_key_value_config(config_path()))
    return {"config": cfg, "sources": load_sources(), "status": system_status(cfg)}


def api_videos() -> Dict[str, Any]:
    fetch_path = script_root() / "bin" / "aerial-fetch"
    cfg = effective_config(parse_key_value_config(config_path()))
    args = [
        "python3",
        str(fetch_path),
        "--config",
        str(config_path()),
        "--source",
        cfg["AERIAL_SOURCE"],
        "--quality",
        cfg["AERIAL_QUALITY"],
        "--manifest-url",
        cfg["AERIAL_MANIFEST_URL"],
        "--cache-dir",
        cfg["AERIAL_CACHE_DIR"],
        "--limit",
        cfg["AERIAL_VIDEO_LIMIT"],
        "--scenes",
        cfg["AERIAL_SCENES"],
        "--hidden-videos",
        cfg["AERIAL_HIDDEN_VIDEOS"],
        "--strict-quality" if bool01(cfg["AERIAL_STRICT_QUALITY"]) == "1" else "--no-strict-quality",
        "--list-videos",
    ]
    result = run_cmd(args, timeout=60)
    videos = []
    if result["ok"]:
        reader = csv.reader(result["stdout"].splitlines(), delimiter="\t")
        for row in reader:
            if len(row) >= 5:
                videos.append(
                    {
                        "id": row[0],
                        "scene": row[1],
                        "label": row[2],
                        "has_h264": row[3] == "1",
                        "cached": row[4] == "1",
                    }
                )
    return {"ok": result["ok"], "videos": videos, "error": result["stderr"]}


PROFILE_KEYS = {
    "AERIAL_SOURCE",
    "AERIAL_QUALITY",
    "AERIAL_VIDEO_LIMIT",
    "AERIAL_STRICT_QUALITY",
    "AERIAL_SCENES",
    "AERIAL_HIDDEN_VIDEOS",
    "AERIAL_SHUFFLE",
}


def profiles_dir() -> Path:
    return Path(os.environ.get("AERIAL_PROFILES_DIR", "/etc/aerial-signage/profiles"))


def profile_path(name: str) -> Path:
    safe = re.sub(r"[^A-Za-z0-9_.-]+", "-", name.strip()).strip(".-")
    if not safe:
        raise ValueError("profile name is required")
    return profiles_dir() / f"{safe}.json"


def list_profiles() -> Dict[str, Any]:
    root = profiles_dir()
    if not root.exists():
        return {"ok": True, "profiles": []}
    profiles = sorted(path.stem for path in root.glob("*.json") if path.is_file())
    return {"ok": True, "profiles": profiles}


def save_profile(name: str, cfg: Dict[str, Any]) -> Dict[str, Any]:
    normalized = normalize_config_payload({key: value for key, value in cfg.items() if key in PROFILE_KEYS})
    path = profile_path(name)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"name": path.stem, "config": normalized}, indent=2, sort_keys=True), encoding="utf-8")
    return {"ok": True, "name": path.stem, "config": normalized}


def load_profile(name: str) -> Dict[str, Any]:
    path = profile_path(name)
    if not path.exists():
        raise ValueError("profile not found")
    payload = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(payload, dict) or not isinstance(payload.get("config"), dict):
        raise ValueError("invalid profile")
    config = normalize_config_payload({key: value for key, value in payload["config"].items() if key in PROFILE_KEYS})
    return {"ok": True, "name": path.stem, "config": config}


def delete_profile(name: str) -> Dict[str, Any]:
    path = profile_path(name)
    if path.exists():
        path.unlink()
    return {"ok": True, "name": path.stem}


WINDOWS_POSITIONS = ["topleft", "topright", "bottomleft", "bottomright", "left", "right", "middle", "topmiddle", "bottommiddle", "random"]
ENV_TO_WINDOWS_CORNER = {value: key for key, value in WINDOWS_CORNER_TO_ENV.items()}
ENV_TO_WINDOWS_CORNER.update({"topCenter": "topmiddle", "bottomCenter": "bottommiddle", "screenCenter": "middle"})


def decode_passthrough(raw: str) -> Dict[str, Any]:
    if not raw:
        return {}
    try:
        payload = json.loads(base64.b64decode(raw.encode("ascii")).decode("utf-8"))
    except Exception:
        return {}
    return payload if isinstance(payload, dict) else {}


def encode_passthrough(payload: Dict[str, Any]) -> str:
    if not payload:
        return ""
    return base64.b64encode(json.dumps(payload, ensure_ascii=False, sort_keys=True).encode("utf-8")).decode("ascii")


def line_from_windows(line: Dict[str, Any]) -> Tuple[Dict[str, str], Dict[str, Any]]:
    mapped: Dict[str, str] = {}
    passthrough = dict(line)
    line_type = line.get("type", "none")
    if line_type == "time":
        mapped["TYPE"] = "timedate"
        mapped["FORMAT"] = str(line.get("timeString") or "hh:mm:ss")
    elif line_type == "information":
        info_type = str(line.get("infoType") or "accessibilityLabel")
        mapped["TYPE"] = "videoname" if info_type in {"name", "videoName"} else "information"
        mapped["INFO_MODE"] = "poi" if info_type == "information" else info_type
    elif line_type == "text":
        mapped["TYPE"] = "message"
        mapped["TEXT"] = str(line.get("text") or "")
    elif line_type == "none":
        mapped["TYPE"] = "none"
    else:
        mapped["TYPE"] = "none"
    mapped["USE_DEFAULT_FONT"] = bool01(line.get("defaultFont", True))
    if isinstance(line.get("font"), str):
        mapped["FONT"] = line["font"]
    if line.get("fontSize") is not None:
        mapped["FONT_SIZE"] = str(line["fontSize"])
    if isinstance(line.get("fontColor"), str):
        mapped["COLOR"] = line["fontColor"].replace("#", "")
    if isinstance(line.get("maxWidth"), str):
        mapped["MAX_WIDTH"] = line["maxWidth"].replace("%", "")
    for key in ("type", "timeString", "infoType", "text", "defaultFont", "font", "fontSize", "fontColor", "maxWidth"):
        passthrough.pop(key, None)
    return mapped, passthrough


def import_windows_config_json(config_text: str) -> Dict[str, Any]:
    try:
        payload = json.loads(config_text)
    except json.JSONDecodeError as exc:
        raise ValueError(f"invalid Windows config.json: {exc}") from exc
    if not isinstance(payload, dict):
        raise ValueError("Windows config root must be an object")

    updates: Dict[str, Any] = {}
    passthrough = dict(payload)
    if isinstance(payload.get("textFont"), str):
        updates["AERIAL_TEXT_FONT"] = payload["textFont"]
        passthrough.pop("textFont", None)
    if payload.get("textSize") is not None:
        updates["AERIAL_TEXT_SIZE"] = str(payload["textSize"])
        passthrough.pop("textSize", None)
    if isinstance(payload.get("textColor"), str):
        updates["AERIAL_TEXT_COLOR"] = payload["textColor"].replace("#", "")
        passthrough.pop("textColor", None)
    if payload.get("randomSpeed") is not None:
        updates["AERIAL_TEXT_RANDOM_INTERVAL"] = str(payload["randomSpeed"])
        passthrough.pop("randomSpeed", None)

    display = payload.get("displayText")
    if isinstance(display, dict):
        passthrough.pop("displayText", None)
        selected_position = None
        selected_lines: List[Dict[str, Any]] = []
        for position in WINDOWS_POSITIONS:
            lines = display.get(position)
            if isinstance(lines, list) and any(isinstance(line, dict) and line.get("type") not in {None, "none"} for line in lines):
                selected_position = position
                selected_lines = [line for line in lines if isinstance(line, dict)]
                break
        if selected_position is None:
            selected_position = "bottomleft"
            selected_lines = []
        updates["AERIAL_TEXT_POSITION"] = WINDOWS_CORNER_TO_ENV.get(selected_position, selected_position)
        for index in range(4):
            prefix = f"AERIAL_LINE{index + 1}"
            line = selected_lines[index] if index < len(selected_lines) else {"type": "none", "defaultFont": True}
            mapped, line_passthrough = line_from_windows(line)
            updates[f"{prefix}_TYPE"] = mapped.get("TYPE", "none")
            updates[f"{prefix}_FORMAT"] = mapped.get("FORMAT", "hh:mm:ss")
            updates[f"{prefix}_TEXT"] = mapped.get("TEXT", "")
            updates[f"{prefix}_INFO_MODE"] = mapped.get("INFO_MODE", "poi")
            updates[f"{prefix}_USE_DEFAULT_FONT"] = mapped.get("USE_DEFAULT_FONT", "1")
            updates[f"{prefix}_FONT"] = mapped.get("FONT", "")
            updates[f"{prefix}_FONT_SIZE"] = mapped.get("FONT_SIZE", updates.get("AERIAL_TEXT_SIZE", "2"))
            updates[f"{prefix}_COLOR"] = mapped.get("COLOR", "")
            if mapped.get("MAX_WIDTH"):
                updates["AERIAL_TEXT_MAX_WIDTH"] = mapped["MAX_WIDTH"]
            if line_passthrough:
                passthrough.setdefault("displayTextLinePassthrough", {})[str(index + 1)] = line_passthrough

    updates["AERIAL_WINDOWS_CONFIG_PASSTHROUGH_B64"] = encode_passthrough(passthrough)
    normalized = normalize_config_payload(updates)
    for key in COLOR_KEYS.intersection(normalized):
        if normalized[key] and not HEX_COLOR_RE.match(normalized[key]):
            raise ValueError(f"{key} must be a 6-hex color")
        normalized[key] = normalized[key].upper()
    return {"ok": True, "config": normalized, "passthrough_keys": sorted(passthrough.keys())}


def windows_line_from_config(cfg: Dict[str, str], line_no: int) -> Dict[str, Any]:
    prefix = f"AERIAL_LINE{line_no}"
    line_type = cfg.get(f"{prefix}_TYPE", "none")
    line: Dict[str, Any] = {"type": "none", "defaultFont": cfg.get(f"{prefix}_USE_DEFAULT_FONT", "1") == "1"}
    if line_type == "timedate":
        line.update({"type": "time", "timeString": cfg.get(f"{prefix}_FORMAT", "hh:mm:ss")})
    elif line_type == "videoname":
        line.update({"type": "information", "infoType": "name"})
    elif line_type in {"information", "poi"}:
        line.update({"type": "information", "infoType": cfg.get(f"{prefix}_INFO_MODE", "poi")})
    elif line_type == "message":
        line.update({"type": "text", "text": cfg.get(f"{prefix}_TEXT", "")})
    if line["type"] != "none":
        if line["defaultFont"] is False:
            line["font"] = cfg.get(f"{prefix}_FONT") or cfg.get("AERIAL_TEXT_FONT", "Segoe UI")
            line["fontSize"] = cfg.get(f"{prefix}_FONT_SIZE") or cfg.get("AERIAL_TEXT_SIZE", "2")
            color = cfg.get(f"{prefix}_COLOR") or cfg.get("AERIAL_TEXT_COLOR", "FFFFFF")
            line["fontColor"] = "#" + color.replace("#", "")
        line["maxWidth"] = cfg.get("AERIAL_TEXT_MAX_WIDTH", "50") + "%"
    return line


def export_windows_config_json(cfg: Dict[str, str]) -> Dict[str, Any]:
    effective = effective_config(cfg)
    payload = decode_passthrough(effective.get("AERIAL_WINDOWS_CONFIG_PASSTHROUGH_B64", ""))
    payload["textFont"] = effective.get("AERIAL_TEXT_FONT", "Segoe UI")
    payload["textSize"] = effective.get("AERIAL_TEXT_SIZE", "2")
    payload["textColor"] = "#" + effective.get("AERIAL_TEXT_COLOR", "FFFFFF").replace("#", "")
    payload["randomSpeed"] = int(float(effective.get("AERIAL_TEXT_RANDOM_INTERVAL", "30")))
    display = {"positionList": WINDOWS_POSITIONS}
    for position in WINDOWS_POSITIONS:
        display[position] = [{"type": "none", "defaultFont": True} for _ in range(4)]
    selected = ENV_TO_WINDOWS_CORNER.get(effective.get("AERIAL_TEXT_POSITION", "bottomLeft"), "bottomleft")
    display[selected] = [windows_line_from_config(effective, index) for index in range(1, 5)]
    payload["displayText"] = display
    return payload


def _json_dict(raw: Any) -> Optional[Dict[str, Any]]:
    if not isinstance(raw, str):
        return None
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return None
    return payload if isinstance(payload, dict) else None


def _json_list(raw: Any) -> Optional[List[Any]]:
    if not isinstance(raw, str):
        return None
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return None
    return payload if isinstance(payload, list) else None


def _bool_string(raw: Any) -> Optional[str]:
    if isinstance(raw, bool):
        return "1" if raw else "0"
    return None


def _number_string(raw: Any) -> Optional[str]:
    if isinstance(raw, (int, float)):
        return str(int(raw))
    return None


def normalize_corner_value(raw: Any) -> Optional[str]:
    if isinstance(raw, (int, float)):
        return SPEC_CORNER_TO_ENV.get(int(raw))
    if isinstance(raw, str):
        return SPEC_CORNER_TO_ENV.get(int(raw)) if raw.isdigit() else WINDOWS_CORNER_TO_ENV.get(raw, raw)
    return None


def translate_datetime_format(raw: str) -> str:
    if "%" in raw:
        return raw
    replacements = {
        "yyyy": "%Y",
        "YYYY": "%Y",
        "yy": "%y",
        "YY": "%y",
        "MMMM": "%B",
        "MMM": "%b",
        "MM": "%m",
        "M": "%m",
        "dd": "%d",
        "DD": "%d",
        "d": "%d",
        "D": "%d",
        "EEEE": "%A",
        "EEE": "%a",
        "HH": "%H",
        "H": "%H",
        "hh": "%I",
        "h": "%I",
        "mm": "%M",
        "m": "%M",
        "ss": "%S",
        "s": "%S",
        "a": "%p",
        "A": "%p",
    }
    tokens = sorted(replacements, key=len, reverse=True)
    out: List[str] = []
    i = 0
    while i < len(raw):
        for token in tokens:
            if raw.startswith(token, i):
                out.append(replacements[token])
                i += len(token)
                break
        else:
            out.append(raw[i])
            i += 1
    return "".join(out)


def apple_reference_seconds_to_unix(raw: Any) -> Optional[float]:
    if not isinstance(raw, (int, float)):
        return None
    return 978307200 + float(raw)


def import_display_settings_plist(plist_text: str) -> Dict[str, Any]:
    try:
        payload = plistlib.loads(plist_text.encode("utf-8"))
    except Exception as exc:  # noqa: BLE001 - API reports parse failures as JSON.
        raise ValueError(f"invalid plist: {exc}") from exc
    if not isinstance(payload, dict):
        raise ValueError("plist root must be a dictionary")

    updates: Dict[str, Any] = {}
    imported_keys: List[str] = []
    skipped_keys: List[str] = []

    def add(key: str, value: Any, source: str) -> None:
        if value is None:
            skipped_keys.append(source)
            return
        candidate = normalize_config_payload({key: value})
        if not candidate:
            skipped_keys.append(source)
            return
        try:
            format_config_line(key, candidate[key])
        except ValueError:
            skipped_keys.append(source)
            return
        updates[key] = candidate[key]
        imported_keys.append(source)

    if isinstance(payload.get("customTimeFormat"), str):
        add("AERIAL_CLOCK_CUSTOM_FORMAT", translate_datetime_format(payload["customTimeFormat"]), "customTimeFormat")
    if isinstance(payload.get("customDateFormat"), str):
        add("AERIAL_DATE_CUSTOM_FORMAT", translate_datetime_format(payload["customDateFormat"]), "customDateFormat")

    layer_keys = _json_list(payload.get("layers"))
    if layer_keys is not None:
        imported_keys.append("layers")

    layer_map = {
        "LayerClock": "AERIAL_CLOCK",
        "LayerDate": "AERIAL_DATE",
        "LayerMessage": "AERIAL_MSG",
        "LayerLocation": "AERIAL_LOC",
    }
    for plist_key, prefix in layer_map.items():
        layer = _json_dict(payload.get(plist_key))
        if layer is None:
            if plist_key in payload:
                skipped_keys.append(plist_key)
            continue
        enabled = _bool_string(layer.get("isEnabled"))
        if enabled is not None:
            add(f"{prefix}_ENABLED", enabled, f"{plist_key}.isEnabled")
        corner = normalize_corner_value(layer.get("corner"))
        if corner is not None:
            add(f"{prefix}_CORNER", corner, f"{plist_key}.corner")
        font_size = _number_string(layer.get("fontSize"))
        if font_size is not None:
            add(f"{prefix}_FONT_SIZE", font_size, f"{plist_key}.fontSize")
        if isinstance(layer.get("fontName"), str):
            add(f"{prefix}_FONT", layer["fontName"], f"{plist_key}.fontName")

        if plist_key == "LayerClock":
            if "showSeconds" in layer:
                add("AERIAL_CLOCK_SECONDS", _bool_string(layer.get("showSeconds")), "LayerClock.showSeconds")
            if "hideAmPm" in layer:
                add("AERIAL_CLOCK_HIDE_AMPM", _bool_string(layer.get("hideAmPm")), "LayerClock.hideAmPm")
            fmt = layer.get("clockFormat")
            if isinstance(fmt, (int, float)) and int(fmt) in SPEC_CLOCK_FORMAT_TO_ENV:
                add("AERIAL_CLOCK_FORMAT", SPEC_CLOCK_FORMAT_TO_ENV[int(fmt)], "LayerClock.clockFormat")
        elif plist_key == "LayerDate":
            if "withYear" in layer:
                add("AERIAL_DATE_WITH_YEAR", _bool_string(layer.get("withYear")), "LayerDate.withYear")
            fmt = layer.get("format")
            if isinstance(fmt, (int, float)) and int(fmt) in SPEC_DATE_FORMAT_TO_ENV:
                add("AERIAL_DATE_FORMAT", SPEC_DATE_FORMAT_TO_ENV[int(fmt)], "LayerDate.format")
        elif plist_key == "LayerMessage":
            message_type = layer.get("messageType", 0)
            if message_type in (0, 0.0) and isinstance(layer.get("message"), str):
                add("AERIAL_MSG_TEXT", layer["message"], "LayerMessage.message")
        elif plist_key == "LayerLocation":
            add("AERIAL_LOC_MODE", "accessibilityLabel", "LayerLocation.mode")

    for key in ("LayerCountdown", "LayerTimer"):
        layer = _json_dict(payload.get(key))
        if layer:
            for date_key in ("targetDate", "triggerDate", "duration"):
                if date_key in layer and apple_reference_seconds_to_unix(layer[date_key]) is None:
                    skipped_keys.append(f"{key}.{date_key}")

    return {"ok": True, "config": updates, "imported_keys": imported_keys, "skipped_keys": skipped_keys}


