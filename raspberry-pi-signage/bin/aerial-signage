#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_dir="$(cd -- "$script_dir/.." && pwd -P)"
lua_dir="$repo_dir/lua"

config_file="${AERIAL_CONFIG:-}"
if [[ -z "$config_file" ]]; then
  for candidate in \
    "/etc/aerial-signage/aerial-signage.conf" \
    "$repo_dir/config/aerial-signage.conf"; do
    if [[ -f "$candidate" ]]; then
      config_file="$candidate"
      break
    fi
  done
fi

if [[ -n "$config_file" && -f "$config_file" ]]; then
  # The same file is parsed by bin/aerial-fetch, so only plain KEY=VALUE lines
  # are supported. The whole line must be a single safe assignment: a quoted
  # value, or an unquoted value without whitespace/shell metacharacters,
  # optionally followed by a comment. Anything else (spaces around '=',
  # 'KEY=x; cmd', 'KEY=x cmd', command substitution) is refused with a clear
  # error instead of being executed by `source` or silently diverging between
  # the two parsers.
  assign_re="^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=(\"[^\"]*\"|'[^']*'|[^[:space:]\"'\`;&|<>]*)([[:space:]]+#.*)?[[:space:]]*$"
  while IFS= read -r line; do
    if [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]]; then
      continue
    fi
    # shellcheck disable=SC2016  # literal '$(' is intentional: we reject command substitution
    if [[ ! "$line" =~ $assign_re ]] || [[ "$line" == *'$('* || "$line" == *'`'* ]]; then
      printf 'Invalid config line in %s: %s\n' "$config_file" "$line" >&2
      printf 'Only single KEY=VALUE assignments are supported (quote values containing spaces; no command substitution).\n' >&2
      exit 1
    fi
  done < "$config_file"
  # Source with -u relaxed so an unset $VAR expands to empty (bash's normal
  # expansion) instead of aborting; bin/aerial-fetch's parser does the same.
  set +u
  # shellcheck source=/dev/null
  . "$config_file"
  set -u
fi

new_text_model_set=0
for key in \
  AERIAL_TEXT_POSITION AERIAL_TEXT_FONT AERIAL_TEXT_SIZE AERIAL_TEXT_COLOR \
  AERIAL_LINE1_TYPE AERIAL_LINE2_TYPE AERIAL_LINE3_TYPE AERIAL_LINE4_TYPE; do
  if [[ -v "$key" ]]; then
    new_text_model_set=1
    break
  fi
done

: "${AERIAL_CLOCK_ENABLED:=1}"
: "${AERIAL_CLOCK_OFFSET_MINUTES:=0}"
: "${AERIAL_CLOCK_FORMAT:=24h}"
: "${AERIAL_CLOCK_SECONDS:=0}"
: "${AERIAL_CLOCK_HIDE_AMPM:=0}"
: "${AERIAL_CLOCK_CUSTOM_FORMAT:=%H:%M}"
: "${AERIAL_CLOCK_CORNER:=bottomLeft}"
: "${AERIAL_CLOCK_FONT_SIZE:=50}"
: "${AERIAL_CLOCK_FONT:=Noto Sans CJK JP}"
: "${AERIAL_CLOCK_MARGIN:=60}"
: "${AERIAL_CLOCK_COLOR:=FFFFFF}"
: "${AERIAL_DATE_ENABLED:=0}"
: "${AERIAL_DATE_CORNER:=bottomLeft}"
: "${AERIAL_DATE_FONT_SIZE:=25}"
: "${AERIAL_DATE_FONT:=Noto Sans CJK JP}"
: "${AERIAL_DATE_COLOR:=FFFFFF}"
: "${AERIAL_DATE_MARGIN:=60}"
: "${AERIAL_DATE_FORMAT:=textual}"
: "${AERIAL_DATE_CUSTOM_FORMAT:=%Y-%m-%d}"
: "${AERIAL_DATE_WITH_YEAR:=0}"
: "${AERIAL_DATE_LANG:=ja}"
: "${AERIAL_LOC_ENABLED:=0}"
: "${AERIAL_LOC_CORNER:=topRight}"
: "${AERIAL_LOC_FONT_SIZE:=28}"
: "${AERIAL_LOC_FONT:=Noto Sans CJK JP}"
: "${AERIAL_LOC_COLOR:=FFFFFF}"
: "${AERIAL_LOC_MARGIN:=60}"
: "${AERIAL_LOC_MODE:=accessibilityLabel}"
: "${AERIAL_LABELS_FILE:=/var/lib/aerial-signage/labels.json}"
: "${AERIAL_MSG_ENABLED:=0}"
: "${AERIAL_MSG_CORNER:=bottomRight}"
: "${AERIAL_MSG_FONT_SIZE:=24}"
: "${AERIAL_MSG_FONT:=Noto Sans CJK JP}"
: "${AERIAL_MSG_COLOR:=FFFFFF}"
: "${AERIAL_MSG_MARGIN:=60}"
: "${AERIAL_OSD_BORDER:=0}"
: "${AERIAL_OSD_SHADOW:=1}"
: "${AERIAL_MSG_TEXT:=Studio Vibes Wi-Fi\nSSID : fcm-dkym-booth\nPW : dkymfcm117}"
: "${AERIAL_QUALITY:=1080-sdr}"
: "${AERIAL_SOURCE:=classic63}"
: "${AERIAL_MANIFEST_URL:=https://raw.githubusercontent.com/kopiro/xscreensaver-apple-aerial/main/entries.json}"
: "${AERIAL_CACHE_DIR:=/var/lib/aerial-signage/videos}"
: "${AERIAL_PLAYLIST:=/var/lib/aerial-signage/playlist.txt}"
: "${AERIAL_VIDEO_LIMIT:=0}"
: "${AERIAL_STRICT_QUALITY:=0}"
: "${AERIAL_SCENES:=}"
: "${AERIAL_HIDDEN_VIDEOS:=}"
: "${AERIAL_SHUFFLE:=1}"
: "${AERIAL_MPV_VO:=gpu}"
: "${AERIAL_MPV_GPU_CONTEXT:=drm}"
: "${AERIAL_MPV_HWDEC:=drm-copy}"
: "${AERIAL_MPV_EXTRA:=}"

moment_from_clock_legacy() {
  case "${AERIAL_CLOCK_FORMAT:-24h}" in
    12h)
      if [[ "${AERIAL_CLOCK_SECONDS:-0}" == "1" ]]; then
        [[ "${AERIAL_CLOCK_HIDE_AMPM:-0}" == "1" ]] && printf 'h:mm:ss' || printf 'h:mm:ss A'
      else
        [[ "${AERIAL_CLOCK_HIDE_AMPM:-0}" == "1" ]] && printf 'h:mm' || printf 'h:mm A'
      fi
      ;;
    custom)
      printf '%s' "${AERIAL_CLOCK_CUSTOM_FORMAT:-%H:%M}" |
        sed -e 's/%Y/YYYY/g' -e 's/%y/YY/g' -e 's/%B/MMMM/g' -e 's/%b/MMM/g' \
          -e 's/%m/MM/g' -e 's/%d/DD/g' -e 's/%A/dddd/g' -e 's/%a/ddd/g' \
          -e 's/%H/HH/g' -e 's/%I/hh/g' -e 's/%M/mm/g' -e 's/%S/ss/g' -e 's/%p/A/g'
      ;;
    *)
      [[ "${AERIAL_CLOCK_SECONDS:-0}" == "1" ]] && printf 'HH:mm:ss' || printf 'HH:mm'
      ;;
  esac
}

moment_from_date_legacy() {
  case "${AERIAL_DATE_FORMAT:-textual}" in
    custom)
      printf '%s' "${AERIAL_DATE_CUSTOM_FORMAT:-%Y-%m-%d}" |
        sed -e 's/%Y/YYYY/g' -e 's/%y/YY/g' -e 's/%B/MMMM/g' -e 's/%b/MMM/g' \
          -e 's/%m/MM/g' -e 's/%d/DD/g' -e 's/%A/dddd/g' -e 's/%a/ddd/g'
      ;;
    compact|numeric)
      [[ "${AERIAL_DATE_WITH_YEAR:-0}" == "1" || "${AERIAL_DATE_FORMAT:-}" == "numeric" ]] && printf 'YYYY/MM/DD' || printf 'MM/DD'
      ;;
    *)
      [[ "${AERIAL_DATE_WITH_YEAR:-0}" == "1" ]] && printf 'YYYY MMMM D dddd' || printf 'MMMM D dddd'
      ;;
  esac
}

legacy_corner_for_text() {
  if [[ "${AERIAL_CLOCK_ENABLED:-0}" == "1" ]]; then
    printf '%s' "${AERIAL_CLOCK_CORNER:-bottomLeft}"
  elif [[ "${AERIAL_DATE_ENABLED:-0}" == "1" ]]; then
    printf '%s' "${AERIAL_DATE_CORNER:-bottomLeft}"
  elif [[ "${AERIAL_LOC_ENABLED:-0}" == "1" ]]; then
    printf '%s' "${AERIAL_LOC_CORNER:-topRight}"
  elif [[ "${AERIAL_MSG_ENABLED:-0}" == "1" ]]; then
    printf '%s' "${AERIAL_MSG_CORNER:-bottomRight}"
  else
    printf 'bottomLeft'
  fi
}

if [[ "$new_text_model_set" == "0" ]]; then
  AERIAL_TEXT_POSITION="$(legacy_corner_for_text)"
  AERIAL_TEXT_FONT="${AERIAL_CLOCK_FONT:-Segoe UI}"
  AERIAL_TEXT_SIZE="2"
  AERIAL_TEXT_COLOR="${AERIAL_CLOCK_COLOR:-FFFFFF}"
  AERIAL_TEXT_RANDOM_INTERVAL="30"
  AERIAL_TEXT_MAX_WIDTH="50"
  line_index=1
  if [[ "${AERIAL_CLOCK_ENABLED:-0}" == "1" ]]; then
    printf -v "AERIAL_LINE${line_index}_TYPE" '%s' "timedate"
    printf -v "AERIAL_LINE${line_index}_FORMAT" '%s' "$(moment_from_clock_legacy)"
    ((line_index += 1))
  fi
  if [[ "${AERIAL_DATE_ENABLED:-0}" == "1" && "$line_index" -le 4 ]]; then
    printf -v "AERIAL_LINE${line_index}_TYPE" '%s' "timedate"
    printf -v "AERIAL_LINE${line_index}_FORMAT" '%s' "$(moment_from_date_legacy)"
    ((line_index += 1))
  fi
  if [[ "${AERIAL_LOC_ENABLED:-0}" == "1" && "$line_index" -le 4 ]]; then
    loc_type="information"
    [[ "${AERIAL_LOC_MODE:-accessibilityLabel}" == "videoName" || "${AERIAL_LOC_MODE:-}" == "name" ]] && loc_type="videoname"
    printf -v "AERIAL_LINE${line_index}_TYPE" '%s' "$loc_type"
    printf -v "AERIAL_LINE${line_index}_INFO_MODE" '%s' "${AERIAL_LOC_MODE:-poi}"
    ((line_index += 1))
  fi
  if [[ "${AERIAL_MSG_ENABLED:-0}" == "1" && "$line_index" -le 4 ]]; then
    printf -v "AERIAL_LINE${line_index}_TYPE" '%s' "message"
    printf -v "AERIAL_LINE${line_index}_TEXT" '%s' "${AERIAL_MSG_TEXT:-}"
    ((line_index += 1))
  fi
fi

: "${AERIAL_TEXT_POSITION:=bottomLeft}"
: "${AERIAL_TEXT_FONT:=Segoe UI}"
: "${AERIAL_TEXT_SIZE:=2}"
: "${AERIAL_TEXT_COLOR:=FFFFFF}"
: "${AERIAL_TEXT_MARGIN:=60}"
: "${AERIAL_TEXT_MAX_WIDTH:=50}"
: "${AERIAL_TEXT_RANDOM_INTERVAL:=30}"
for line_index in 1 2 3 4; do
  type_key="AERIAL_LINE${line_index}_TYPE"
  format_key="AERIAL_LINE${line_index}_FORMAT"
  text_key="AERIAL_LINE${line_index}_TEXT"
  info_key="AERIAL_LINE${line_index}_INFO_MODE"
  default_font_key="AERIAL_LINE${line_index}_USE_DEFAULT_FONT"
  font_key="AERIAL_LINE${line_index}_FONT"
  size_key="AERIAL_LINE${line_index}_FONT_SIZE"
  color_key="AERIAL_LINE${line_index}_COLOR"
  printf -v "$type_key" '%s' "${!type_key:-none}"
  printf -v "$format_key" '%s' "${!format_key:-hh:mm:ss}"
  printf -v "$text_key" '%s' "${!text_key:-}"
  printf -v "$info_key" '%s' "${!info_key:-poi}"
  printf -v "$default_font_key" '%s' "${!default_font_key:-1}"
  printf -v "$font_key" '%s' "${!font_key:-}"
  printf -v "$size_key" '%s' "${!size_key:-$AERIAL_TEXT_SIZE}"
  printf -v "$color_key" '%s' "${!color_key:-}"
done

if [[ ! -s "$AERIAL_PLAYLIST" ]]; then
  printf 'Playlist is missing or empty: %s\n' "$AERIAL_PLAYLIST" >&2
  printf 'Run aerial-fetch first, for example:\n' >&2
  printf '  AERIAL_CONFIG=%s %s/bin/aerial-fetch\n' "${config_file:-/etc/aerial-signage/aerial-signage.conf}" "$repo_dir" >&2
  exit 1
fi

export AERIAL_CLOCK_ENABLED
export AERIAL_CLOCK_OFFSET_MINUTES
export AERIAL_CLOCK_FORMAT
export AERIAL_CLOCK_SECONDS
export AERIAL_CLOCK_HIDE_AMPM
export AERIAL_CLOCK_CUSTOM_FORMAT
export AERIAL_CLOCK_CORNER
export AERIAL_CLOCK_FONT_SIZE
export AERIAL_CLOCK_FONT
export AERIAL_CLOCK_MARGIN
export AERIAL_CLOCK_COLOR
export AERIAL_DATE_ENABLED
export AERIAL_DATE_CORNER
export AERIAL_DATE_FONT_SIZE
export AERIAL_DATE_FONT
export AERIAL_DATE_COLOR
export AERIAL_DATE_MARGIN
export AERIAL_DATE_FORMAT
export AERIAL_DATE_CUSTOM_FORMAT
export AERIAL_DATE_WITH_YEAR
export AERIAL_DATE_LANG
export AERIAL_LOC_ENABLED
export AERIAL_LOC_CORNER
export AERIAL_LOC_FONT_SIZE
export AERIAL_LOC_FONT
export AERIAL_LOC_COLOR
export AERIAL_LOC_MARGIN
export AERIAL_LOC_MODE
export AERIAL_LABELS_FILE
export AERIAL_MSG_ENABLED
export AERIAL_MSG_CORNER
export AERIAL_MSG_FONT_SIZE
export AERIAL_MSG_FONT
export AERIAL_MSG_COLOR
export AERIAL_MSG_MARGIN
export AERIAL_MSG_TEXT
export AERIAL_OSD_BORDER
export AERIAL_OSD_SHADOW
export AERIAL_TEXT_POSITION
export AERIAL_TEXT_FONT
export AERIAL_TEXT_SIZE
export AERIAL_TEXT_COLOR
export AERIAL_TEXT_MARGIN
export AERIAL_TEXT_MAX_WIDTH
export AERIAL_TEXT_RANDOM_INTERVAL
for line_index in 1 2 3 4; do
  export "AERIAL_LINE${line_index}_TYPE"
  export "AERIAL_LINE${line_index}_FORMAT"
  export "AERIAL_LINE${line_index}_TEXT"
  export "AERIAL_LINE${line_index}_INFO_MODE"
  export "AERIAL_LINE${line_index}_USE_DEFAULT_FONT"
  export "AERIAL_LINE${line_index}_FONT"
  export "AERIAL_LINE${line_index}_FONT_SIZE"
  export "AERIAL_LINE${line_index}_COLOR"
done

mpv_args=(
  --fullscreen
  --loop-playlist=inf
  --no-audio
  --no-osc
  --no-input-default-bindings
  --no-terminal
  --really-quiet
  --force-window=yes
  --idle=no
  --keep-open=no
  --prefetch-playlist=yes
  "--vo=$AERIAL_MPV_VO"
  "--gpu-context=$AERIAL_MPV_GPU_CONTEXT"
  "--hwdec=$AERIAL_MPV_HWDEC"
  "--script=$lua_dir/clock-overlay.lua"
)

if [[ "$AERIAL_SHUFFLE" == "1" ]]; then
  mpv_args=(--shuffle "${mpv_args[@]}")
fi

if [[ -n "$AERIAL_MPV_EXTRA" ]]; then
  extra_args=()
  read -r -a extra_args <<< "$AERIAL_MPV_EXTRA"
  mpv_args+=("${extra_args[@]}")
fi

mpv_args+=("--playlist=$AERIAL_PLAYLIST")

exec mpv "${mpv_args[@]}"
