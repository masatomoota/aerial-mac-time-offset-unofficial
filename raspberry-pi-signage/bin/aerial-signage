#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_dir="$(cd -- "$script_dir/.." && pwd -P)"
lua_dir="$repo_dir/lua"

config_file="${AERIAL_CONFIG:-}"
if [[ -z "$config_file" ]]; then
  for candidate in \
    "/etc/aerial-signage/aerial-signage.conf" \
    "$repo_dir/config/aerial-signage.conf"; do
    if [[ -f "$candidate" ]]; then
      config_file="$candidate"
      break
    fi
  done
fi

if [[ -n "$config_file" && -f "$config_file" ]]; then
  # The same file is parsed by bin/aerial-fetch, so only plain KEY=VALUE lines
  # are supported. The whole line must be a single safe assignment: a quoted
  # value, or an unquoted value without whitespace/shell metacharacters,
  # optionally followed by a comment. Anything else (spaces around '=',
  # 'KEY=x; cmd', 'KEY=x cmd', command substitution) is refused with a clear
  # error instead of being executed by `source` or silently diverging between
  # the two parsers.
  assign_re="^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=(\"[^\"]*\"|'[^']*'|[^[:space:]\"'\`;&|<>]*)([[:space:]]+#.*)?[[:space:]]*$"
  while IFS= read -r line; do
    if [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]]; then
      continue
    fi
    # shellcheck disable=SC2016  # literal '$(' is intentional: we reject command substitution
    if [[ ! "$line" =~ $assign_re ]] || [[ "$line" == *'$('* || "$line" == *'`'* ]]; then
      printf 'Invalid config line in %s: %s\n' "$config_file" "$line" >&2
      printf 'Only single KEY=VALUE assignments are supported (quote values containing spaces; no command substitution).\n' >&2
      exit 1
    fi
  done < "$config_file"
  # Source with -u relaxed so an unset $VAR expands to empty (bash's normal
  # expansion) instead of aborting; bin/aerial-fetch's parser does the same.
  set +u
  # shellcheck source=/dev/null
  . "$config_file"
  set -u
fi

: "${AERIAL_CLOCK_ENABLED:=1}"
: "${AERIAL_CLOCK_OFFSET_MINUTES:=10}"
: "${AERIAL_CLOCK_FORMAT:=24h}"
: "${AERIAL_CLOCK_SECONDS:=0}"
: "${AERIAL_CLOCK_HIDE_AMPM:=0}"
: "${AERIAL_CLOCK_CUSTOM_FORMAT:=%H:%M}"
: "${AERIAL_CLOCK_CORNER:=bottomLeft}"
: "${AERIAL_CLOCK_FONT_SIZE:=50}"
: "${AERIAL_CLOCK_FONT:=Noto Sans CJK JP}"
: "${AERIAL_CLOCK_MARGIN:=60}"
: "${AERIAL_CLOCK_COLOR:=FFFFFF}"
: "${AERIAL_DATE_ENABLED:=1}"
: "${AERIAL_DATE_CORNER:=bottomLeft}"
: "${AERIAL_DATE_FONT_SIZE:=25}"
: "${AERIAL_DATE_FONT:=Noto Sans CJK JP}"
: "${AERIAL_DATE_COLOR:=FFFFFF}"
: "${AERIAL_DATE_MARGIN:=60}"
: "${AERIAL_DATE_FORMAT:=textual}"
: "${AERIAL_DATE_WITH_YEAR:=0}"
: "${AERIAL_DATE_LANG:=ja}"
: "${AERIAL_LOC_ENABLED:=1}"
: "${AERIAL_LOC_CORNER:=topRight}"
: "${AERIAL_LOC_FONT_SIZE:=28}"
: "${AERIAL_LOC_FONT:=Noto Sans CJK JP}"
: "${AERIAL_LOC_COLOR:=FFFFFF}"
: "${AERIAL_LOC_MARGIN:=60}"
: "${AERIAL_LABELS_FILE:=/var/lib/aerial-signage/labels.tsv}"
: "${AERIAL_MSG_ENABLED:=1}"
: "${AERIAL_MSG_CORNER:=bottomRight}"
: "${AERIAL_MSG_FONT_SIZE:=24}"
: "${AERIAL_MSG_FONT:=Noto Sans CJK JP}"
: "${AERIAL_MSG_COLOR:=FFFFFF}"
: "${AERIAL_MSG_MARGIN:=60}"
: "${AERIAL_OSD_BORDER:=0}"
: "${AERIAL_OSD_SHADOW:=1}"
: "${AERIAL_MSG_TEXT:=Studio Vibes Wi-Fi\nSSID : fcm-dkym-booth\nPW : dkymfcm117}"
: "${AERIAL_QUALITY:=1080-sdr}"
: "${AERIAL_SOURCE:=classic63}"
: "${AERIAL_MANIFEST_URL:=https://raw.githubusercontent.com/kopiro/xscreensaver-apple-aerial/main/entries.json}"
: "${AERIAL_CACHE_DIR:=/var/lib/aerial-signage/videos}"
: "${AERIAL_PLAYLIST:=/var/lib/aerial-signage/playlist.txt}"
: "${AERIAL_VIDEO_LIMIT:=0}"
: "${AERIAL_STRICT_QUALITY:=0}"
: "${AERIAL_SCENES:=}"
: "${AERIAL_HIDDEN_VIDEOS:=}"
: "${AERIAL_SHUFFLE:=1}"
: "${AERIAL_MPV_VO:=gpu}"
: "${AERIAL_MPV_GPU_CONTEXT:=drm}"
: "${AERIAL_MPV_HWDEC:=drm-copy}"
: "${AERIAL_MPV_EXTRA:=}"

if [[ ! -s "$AERIAL_PLAYLIST" ]]; then
  printf 'Playlist is missing or empty: %s\n' "$AERIAL_PLAYLIST" >&2
  printf 'Run aerial-fetch first, for example:\n' >&2
  printf '  AERIAL_CONFIG=%s %s/bin/aerial-fetch\n' "${config_file:-/etc/aerial-signage/aerial-signage.conf}" "$repo_dir" >&2
  exit 1
fi

export AERIAL_CLOCK_ENABLED
export AERIAL_CLOCK_OFFSET_MINUTES
export AERIAL_CLOCK_FORMAT
export AERIAL_CLOCK_SECONDS
export AERIAL_CLOCK_HIDE_AMPM
export AERIAL_CLOCK_CUSTOM_FORMAT
export AERIAL_CLOCK_CORNER
export AERIAL_CLOCK_FONT_SIZE
export AERIAL_CLOCK_FONT
export AERIAL_CLOCK_MARGIN
export AERIAL_CLOCK_COLOR
export AERIAL_DATE_ENABLED
export AERIAL_DATE_CORNER
export AERIAL_DATE_FONT_SIZE
export AERIAL_DATE_FONT
export AERIAL_DATE_COLOR
export AERIAL_DATE_MARGIN
export AERIAL_DATE_FORMAT
export AERIAL_DATE_WITH_YEAR
export AERIAL_DATE_LANG
export AERIAL_LOC_ENABLED
export AERIAL_LOC_CORNER
export AERIAL_LOC_FONT_SIZE
export AERIAL_LOC_FONT
export AERIAL_LOC_COLOR
export AERIAL_LOC_MARGIN
export AERIAL_LABELS_FILE
export AERIAL_MSG_ENABLED
export AERIAL_MSG_CORNER
export AERIAL_MSG_FONT_SIZE
export AERIAL_MSG_FONT
export AERIAL_MSG_COLOR
export AERIAL_MSG_MARGIN
export AERIAL_MSG_TEXT
export AERIAL_OSD_BORDER
export AERIAL_OSD_SHADOW

mpv_args=(
  --fullscreen
  --loop-playlist=inf
  --no-audio
  --no-osc
  --no-input-default-bindings
  --no-terminal
  --really-quiet
  --force-window=yes
  --idle=no
  --keep-open=no
  --prefetch-playlist=yes
  "--vo=$AERIAL_MPV_VO"
  "--gpu-context=$AERIAL_MPV_GPU_CONTEXT"
  "--hwdec=$AERIAL_MPV_HWDEC"
  "--script=$lua_dir/clock-overlay.lua"
)

if [[ "$AERIAL_SHUFFLE" == "1" ]]; then
  mpv_args=(--shuffle "${mpv_args[@]}")
fi

if [[ -n "$AERIAL_MPV_EXTRA" ]]; then
  extra_args=()
  read -r -a extra_args <<< "$AERIAL_MPV_EXTRA"
  mpv_args+=("${extra_args[@]}")
fi

mpv_args+=("--playlist=$AERIAL_PLAYLIST")

exec mpv "${mpv_args[@]}"
