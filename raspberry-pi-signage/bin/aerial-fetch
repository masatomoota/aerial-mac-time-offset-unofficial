#!/usr/bin/env python3
"""Fetch Apple Aerial videos for the Raspberry Pi signage player."""

from __future__ import annotations

import argparse
import json
import os
import plistlib
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Tuple


DEFAULTS = {
    "AERIAL_QUALITY": "1080-sdr",
    "AERIAL_SOURCE": "classic63",
    "AERIAL_MANIFEST_URL": "https://raw.githubusercontent.com/kopiro/xscreensaver-apple-aerial/main/entries.json",
    "AERIAL_CACHE_DIR": "/var/lib/aerial-signage/videos",
    "AERIAL_PLAYLIST": "/var/lib/aerial-signage/playlist.txt",
    "AERIAL_VIDEO_LIMIT": "0",
    "AERIAL_STRICT_QUALITY": "0",
    "AERIAL_SCENES": "",
    "AERIAL_HIDDEN_VIDEOS": "",
}


def is_truthy(value: str) -> bool:
    return str(value).strip().lower() in ("1", "true", "yes", "on")

QUALITY_KEYS = {
    "1080-sdr": "url-1080-SDR",
    "1080-hdr": "url-1080-HDR",
    "4k-sdr": "url-4K-SDR",
    "4k-hdr": "url-4K-HDR",
    "1080-h264": "url-1080-H264",
}

FALLBACK_KEYS = ["url-1080-SDR", "url-4K-SDR", "url-1080-H264"]
SCENES = {"countryside", "nature", "city", "beach", "sea", "space", "other"}


def log(message: str) -> None:
    print(f"aerial-fetch: {message}", file=sys.stderr)


def script_root() -> Path:
    return Path(__file__).resolve().parent.parent


def bundled_manifest_path() -> Path:
    return script_root() / "manifest" / "entries.json"


def sources_path() -> Path:
    return script_root() / "manifest" / "sources.json"


def scene_map_path() -> Path:
    return script_root() / "manifest" / "scene_map.json"


def poi_strings_path() -> Path:
    return script_root() / "manifest" / "poi-strings.json"


CONFIG_LINE_RE = re.compile(r"^([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
CONFIG_VAR_RE = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)")


def _expand_config_value(value: str, scope: Dict[str, str]) -> str:
    """Expand $VAR/${VAR} against earlier config assignments, then the
    process environment. Unknown variables expand to empty, exactly like
    bash expansion when bin/aerial-signage sources the same file."""

    def replace(match: "re.Match[str]") -> str:
        name = match.group(1) or match.group(2)
        if name in scope:
            return scope[name]
        return os.environ.get(name, "")

    return CONFIG_VAR_RE.sub(replace, value)


def parse_key_value_config(path: Path) -> Dict[str, str]:
    """Parse the KEY=VALUE config the same way bash `source` reads assignments.

    bin/aerial-signage sources the same file (after validating each line is a
    single safe assignment), so the two parsers must agree: no whitespace
    around `=`, a whitespace-preceded `#` starts a comment, matching outer
    quotes are stripped (with an optional trailing comment after the closing
    quote), and $VAR references are expanded against earlier assignments and
    the environment (except inside single quotes). Lines the launcher would
    refuse are skipped with a warning instead of being misread.
    """
    values: Dict[str, str] = {}
    if not path.exists():
        return values

    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        match = CONFIG_LINE_RE.match(line)
        if match is None:
            log(f"ignoring config line (not KEY=VALUE): {line!r}")
            continue
        key, value = match.group(1), match.group(2).strip()
        expand = True
        if value[:1] in ("'", '"'):
            quote = value[0]
            end = value.find(quote, 1)
            rest = value[end + 1 :].strip() if end != -1 else None
            if end == -1 or (rest and not rest.startswith("#")):
                log(f"ignoring config line (unsupported quoting): {line!r}")
                continue
            if quote == "'":
                expand = False
            value = value[1:end]
        else:
            # bash treats a whitespace-preceded # as a comment start.
            value = re.split(r"\s#", value, maxsplit=1)[0].strip()
            if re.search(r"\s", value):
                # 'KEY=a b' is not a plain assignment in bash; the launcher
                # refuses it, so skip it here too instead of diverging.
                log(f"ignoring config line (unquoted whitespace): {line!r}")
                continue
        values[key] = _expand_config_value(value, values) if expand else value
    return values


def merged_config(args: argparse.Namespace) -> Dict[str, str]:
    cfg = dict(DEFAULTS)
    config_path = args.config or os.environ.get("AERIAL_CONFIG")
    if config_path:
        cfg.update(parse_key_value_config(Path(config_path)))

    for key in DEFAULTS:
        if key in os.environ:
            cfg[key] = os.environ[key]

    overrides = {
        "AERIAL_QUALITY": args.quality,
        "AERIAL_SOURCE": args.source,
        "AERIAL_MANIFEST_URL": args.manifest_url,
        "AERIAL_CACHE_DIR": args.cache_dir,
        "AERIAL_PLAYLIST": args.playlist,
        "AERIAL_VIDEO_LIMIT": str(args.limit) if args.limit is not None else None,
        "AERIAL_STRICT_QUALITY": None if args.strict_quality is None else ("1" if args.strict_quality else "0"),
        "AERIAL_SCENES": args.scenes,
        "AERIAL_HIDDEN_VIDEOS": args.hidden_videos,
    }
    for key, value in overrides.items():
        if value is not None:
            cfg[key] = value
    return cfg


def normalize_entries(manifest: Any) -> List[Dict[str, Any]]:
    if isinstance(manifest, list):
        raw_entries = manifest
    elif isinstance(manifest, dict) and isinstance(manifest.get("assets"), list):
        raw_entries = manifest["assets"]
    else:
        raise ValueError("manifest must be a list or an object with an assets list")
    return [entry for entry in raw_entries if isinstance(entry, dict)]


def load_json_file(path: Path, default: Any) -> Any:
    try:
        with path.open("r", encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        return default


def _decode_strings_text(raw: bytes) -> str:
    if raw.startswith((b"\xff\xfe", b"\xfe\xff")):
        return raw.decode("utf-16")
    sample = raw[:200]
    if sample[1::2].count(0) > max(2, len(sample) // 8):
        return raw.decode("utf-16-le")
    if sample[0::2].count(0) > max(2, len(sample) // 8):
        return raw.decode("utf-16-be")
    try:
        return raw.decode("utf-8-sig")
    except UnicodeDecodeError:
        return raw.decode("utf-16")


def _skip_strings_ws(text: str, index: int) -> int:
    while index < len(text):
        if text[index].isspace() or text[index] == "\ufeff":
            index += 1
            continue
        if text.startswith("//", index):
            end = text.find("\n", index + 2)
            index = len(text) if end == -1 else end + 1
            continue
        if text.startswith("/*", index):
            end = text.find("*/", index + 2)
            index = len(text) if end == -1 else end + 2
            continue
        break
    return index


def _parse_strings_quoted(text: str, index: int) -> Tuple[str, int]:
    if index >= len(text) or text[index] != '"':
        raise ValueError("expected quoted string")
    index += 1
    out: List[str] = []
    while index < len(text):
        ch = text[index]
        if ch == '"':
            return "".join(out), index + 1
        if ch != "\\":
            out.append(ch)
            index += 1
            continue
        index += 1
        if index >= len(text):
            raise ValueError("unterminated escape")
        esc = text[index]
        simple = {"n": "\n", "r": "\r", "t": "\t", '"': '"', "\\": "\\"}
        if esc in simple:
            out.append(simple[esc])
            index += 1
        elif esc in {"U", "u"} and index + 4 < len(text):
            digits = text[index + 1 : index + 5]
            if not re.match(r"^[0-9A-Fa-f]{4}$", digits):
                raise ValueError("invalid unicode escape")
            out.append(chr(int(digits, 16)))
            index += 5
        else:
            out.append(esc)
            index += 1
    raise ValueError("unterminated quoted string")


def parse_apple_strings_bytes(raw: bytes) -> Dict[str, str]:
    """Parse Apple .strings data using only stdlib paths.

    tvOS bundles may ship as binary plists; source fixtures and older bundles
    may use the classic quoted `key = value;` text format in UTF-8 or UTF-16.
    """
    if raw.startswith(b"bplist00"):
        payload = plistlib.loads(raw)
        if not isinstance(payload, dict):
            raise ValueError("binary strings plist root must be a dictionary")
        return {str(key): str(value) for key, value in payload.items()}

    text = _decode_strings_text(raw)
    index = 0
    parsed: Dict[str, str] = {}
    while True:
        index = _skip_strings_ws(text, index)
        if index >= len(text):
            return parsed
        key, index = _parse_strings_quoted(text, index)
        index = _skip_strings_ws(text, index)
        if index >= len(text) or text[index] != "=":
            raise ValueError("expected = after key")
        index = _skip_strings_ws(text, index + 1)
        value, index = _parse_strings_quoted(text, index)
        index = _skip_strings_ws(text, index)
        if index >= len(text) or text[index] != ";":
            raise ValueError("expected ; after value")
        parsed[key] = value
        index += 1


def parse_apple_strings_file(path: Path) -> Dict[str, str]:
    return parse_apple_strings_bytes(path.read_bytes())


def load_poi_strings(path: Optional[Path] = None) -> Dict[str, Dict[str, str]]:
    data = load_json_file(path or poi_strings_path(), {})
    if not isinstance(data, dict):
        return {}
    locales: Dict[str, Dict[str, str]] = {}
    for locale, values in data.items():
        if isinstance(locale, str) and isinstance(values, dict):
            locales[locale] = {str(key): str(value) for key, value in values.items() if isinstance(value, str)}
    return locales


def load_sources(path: Optional[Path] = None) -> List[Dict[str, Any]]:
    data = load_json_file(path or sources_path(), {"sources": []})
    if not isinstance(data, dict) or not isinstance(data.get("sources"), list):
        return []
    return [item for item in data["sources"] if isinstance(item, dict)]


def resolve_manifest_url(source_id: str, manifest_url: str, source_items: Optional[List[Dict[str, Any]]] = None) -> str:
    if manifest_url and manifest_url != DEFAULTS["AERIAL_MANIFEST_URL"]:
        return manifest_url
    for source in source_items if source_items is not None else load_sources():
        if source.get("id") == source_id and isinstance(source.get("manifest_url"), str):
            return str(source["manifest_url"])
    return DEFAULTS["AERIAL_MANIFEST_URL"]


def parse_csv(raw: str) -> List[str]:
    return [item.strip() for item in str(raw or "").split(",") if item.strip()]


def normalize_scene(raw: Any) -> Optional[str]:
    if not isinstance(raw, str) or not raw.strip():
        return None
    value = raw.strip().lower().replace(" ", "_").replace("-", "_")
    aliases = {
        "countryside": "countryside",
        "landscape": "nature",
        "nature": "nature",
        "city": "city",
        "cityscape": "city",
        "urban": "city",
        "beach": "beach",
        "sea": "sea",
        "ocean": "sea",
        "underwater": "sea",
        "space": "space",
        "earth": "space",
        "other": "other",
    }
    return aliases.get(value, value if value in SCENES else "other")


def load_scene_map(path: Optional[Path] = None) -> Dict[str, str]:
    data = load_json_file(path or scene_map_path(), {})
    if not isinstance(data, dict):
        return {}
    scene_map: Dict[str, str] = {}
    for key, value in data.items():
        scene = normalize_scene(value)
        if isinstance(key, str) and scene:
            scene_map[key] = scene
    return scene_map


def entry_id(entry: Dict[str, Any]) -> str:
    raw = entry.get("id")
    if isinstance(raw, str) and raw:
        return raw
    for key in QUALITY_KEYS.values():
        url = entry.get(key)
        if isinstance(url, str) and url:
            return filename_for_url(url)
    return ""


def entry_label(entry: Dict[str, Any]) -> str:
    for key in ("accessibilityLabel", "label", "name", "title"):
        raw = entry.get(key)
        if isinstance(raw, str) and raw:
            return raw
    return entry_id(entry)


def entry_name(entry: Dict[str, Any]) -> str:
    for key in ("name", "title", "accessibilityLabel", "label"):
        raw = entry.get(key)
        if isinstance(raw, str) and raw:
            return raw
    return entry_id(entry)


def entry_poi_json(entry: Dict[str, Any]) -> str:
    raw = entry.get("pointsOfInterest")
    if isinstance(raw, dict):
        clean = {str(key): str(value) for key, value in raw.items() if str(value)}
        return json.dumps(clean, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return ""


def _looks_like_localization_key(value: str) -> bool:
    return bool(re.match(r"^[A-Za-z0-9_]+$", value))


def entry_poi_rows(entry: Dict[str, Any], poi_strings: Dict[str, Dict[str, str]]) -> List[Dict[str, Any]]:
    raw = entry.get("pointsOfInterest")
    if not isinstance(raw, dict):
        return []
    rows: List[Dict[str, Any]] = []
    for seconds, key in raw.items():
        try:
            numeric_seconds = int(float(str(seconds)))
        except (TypeError, ValueError):
            continue
        raw_key = str(key)
        if not raw_key:
            continue
        text_ja = poi_strings.get("ja", {}).get(raw_key, "")
        text_en = poi_strings.get("en", {}).get(raw_key, "")
        if not text_ja and not text_en and not _looks_like_localization_key(raw_key):
            text_en = raw_key
        rows.append({"t": numeric_seconds, "key": raw_key, "text_ja": text_ja, "text_en": text_en})
    rows.sort(key=lambda row: row["t"])
    return rows


def resolve_scene(entry: Dict[str, Any], scene_map: Dict[str, str]) -> str:
    scene = normalize_scene(entry.get("scene") or entry.get("category"))
    if scene:
        return scene
    # tvOS13+ manifests: entry["categories"] is a list of category UUIDs; the
    # bundled scene_map.json maps those UUIDs to scene names.
    raw_categories = entry.get("categories")
    if isinstance(raw_categories, list):
        for category in raw_categories:
            if isinstance(category, str) and category in scene_map:
                return scene_map[category]
    asset_id = entry_id(entry)
    label = entry_label(entry)
    for needle, mapped_scene in scene_map.items():
        if needle == asset_id or needle.lower() in label.lower():
            return mapped_scene
    return "nature"


def filter_entries(
    entries: Iterable[Dict[str, Any]], scenes_csv: str, hidden_csv: str, scene_map: Dict[str, str]
) -> List[Dict[str, Any]]:
    wanted = {normalize_scene(item) for item in parse_csv(scenes_csv)}
    wanted.discard(None)
    hidden = set(parse_csv(hidden_csv))
    filtered: List[Dict[str, Any]] = []
    for entry in entries:
        asset_id = entry_id(entry)
        scene = resolve_scene(entry, scene_map)
        if wanted and scene not in wanted:
            continue
        if asset_id in hidden:
            continue
        filtered.append(entry)
    return filtered


def quality_to_key(quality: str) -> str:
    try:
        return QUALITY_KEYS[quality]
    except KeyError as exc:
        valid = ", ".join(sorted(QUALITY_KEYS))
        raise ValueError(f"unknown quality {quality!r}; expected one of: {valid}") from exc


def select_variant(entry: Dict[str, Any], quality: str, strict: bool = False) -> Optional[Tuple[str, str]]:
    chosen = quality_to_key(quality)
    if strict:
        keys = [chosen]
    else:
        keys = [chosen] + [key for key in FALLBACK_KEYS if key != chosen]
    for key in keys:
        value = entry.get(key)
        if isinstance(value, str) and value:
            return key, value
    return None


def select_urls(
    entries: Iterable[Dict[str, Any]], quality: str, limit: int = 0, strict: bool = False
) -> List[str]:
    urls: List[str] = []
    for entry in entries:
        selected = select_variant(entry, quality, strict)
        if selected is None:
            continue
        urls.append(selected[1])
        if limit > 0 and len(urls) >= limit:
            break
    return urls


def select_entries(
    entries: Iterable[Dict[str, Any]], quality: str, limit: int = 0, strict: bool = False
) -> List[Tuple[Dict[str, Any], str]]:
    selected_entries: List[Tuple[Dict[str, Any], str]] = []
    for entry in entries:
        selected = select_variant(entry, quality, strict)
        if selected is None:
            continue
        selected_entries.append((entry, selected[1]))
        if limit > 0 and len(selected_entries) >= limit:
            break
    return selected_entries


def dry_run_urls(manifest: Any, quality: str, limit: int = 0, strict: bool = False) -> List[str]:
    return select_urls(normalize_entries(manifest), quality, limit, strict)


def fetch_url(url: str, timeout: int = 45) -> bytes:
    request = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        status = getattr(response, "status", 200)
        if status not in (None, 200):
            raise RuntimeError(f"HTTP {status} for {url}")
        return response.read()


def load_manifest(manifest_url: str, source_id: str = "") -> Tuple[List[Dict[str, Any]], str]:
    try:
        data = fetch_url(manifest_url)
        entries = normalize_entries(json.loads(data.decode("utf-8")))
        log(f"using remote manifest {manifest_url}")
        return entries, manifest_url
    except Exception as exc:  # noqa: BLE001 - fall back on any fetch/parse/schema failure.
        fallback = bundled_manifest_path()
        if source_id:
            per_source = script_root() / "manifest" / f"entries-{source_id}.json"
            if per_source.exists():
                fallback = per_source
        log(f"remote manifest failed ({exc}); using bundled fallback {fallback}")
        with fallback.open("r", encoding="utf-8") as handle:
            return normalize_entries(json.load(handle)), str(fallback)


def filename_for_url(url: str) -> str:
    path = urllib.parse.urlparse(url).path
    name = os.path.basename(path)
    if not name:
        raise ValueError(f"cannot derive filename from URL: {url}")
    return name


def fsync_directory(path: Path) -> None:
    try:
        fd = os.open(str(path), os.O_RDONLY)
    except OSError:
        return
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def download_one(url: str, cache_dir: Path) -> Optional[Path]:
    try:
        name = filename_for_url(url)
    except ValueError as exc:
        log(f"skipping URL ({exc})")
        return None
    final_path = cache_dir / name
    part_path = cache_dir / f"{name}.part"

    if final_path.exists() and final_path.stat().st_size > 0:
        log(f"skip existing {final_path}")
        return final_path

    for attempt in range(1, 4):
        try:
            request = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(request, timeout=60) as response:
                status = getattr(response, "status", 200)
                if status != 200:
                    raise RuntimeError(f"HTTP {status}")
                expected_raw = response.headers.get("Content-Length")
                expected = int(expected_raw) if expected_raw else None
                total = 0
                with part_path.open("wb") as handle:
                    while True:
                        chunk = response.read(1024 * 1024)
                        if not chunk:
                            break
                        handle.write(chunk)
                        total += len(chunk)
                    handle.flush()
                    os.fsync(handle.fileno())
                if expected is not None and total != expected:
                    raise RuntimeError(f"short download: got {total}, expected {expected}")
                if total <= 0:
                    raise RuntimeError("empty download")
                part_path.replace(final_path)
                fsync_directory(cache_dir)
                log(f"downloaded {final_path}")
                return final_path
        except Exception as exc:  # noqa: BLE001 - retry all transient download failures.
            try:
                part_path.unlink()
            except FileNotFoundError:
                pass
            log(f"download failed attempt {attempt}/3 for {url}: {exc}")
            if attempt < 3:
                time.sleep(attempt * 2)
    return None


def write_playlist(paths: Iterable[Path], playlist: Path) -> None:
    playlist.parent.mkdir(parents=True, exist_ok=True)
    lines = [str(path.resolve()) for path in paths]
    tmp_path = playlist.with_suffix(playlist.suffix + ".part")
    tmp_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    with tmp_path.open("rb") as handle:
        os.fsync(handle.fileno())
    tmp_path.replace(playlist)
    fsync_directory(playlist.parent)


def tsv_field(value: Any) -> str:
    return str(value or "").replace("\t", " ").replace("\r", " ").replace("\n", " ")


def write_labels(rows: Iterable[Tuple[str, ...]], labels_file: Path) -> None:
    labels_file.parent.mkdir(parents=True, exist_ok=True)
    lines = ["\t".join(tsv_field(field) for field in row) for row in rows]
    tmp_path = labels_file.with_suffix(labels_file.suffix + ".part")
    tmp_path.write_text("\n".join(lines) + ("\n" if lines else ""), encoding="utf-8")
    with tmp_path.open("rb") as handle:
        os.fsync(handle.fileno())
    tmp_path.replace(labels_file)
    fsync_directory(labels_file.parent)


def write_labels_json(rows: Iterable[Dict[str, Any]], labels_file: Path) -> None:
    labels_file.parent.mkdir(parents=True, exist_ok=True)
    payload = {"videos": list(rows)}
    tmp_path = labels_file.with_suffix(labels_file.suffix + ".part")
    tmp_path.write_text(json.dumps(payload, ensure_ascii=False, sort_keys=True, indent=2) + "\n", encoding="utf-8")
    with tmp_path.open("rb") as handle:
        os.fsync(handle.fileno())
    tmp_path.replace(labels_file)
    fsync_directory(labels_file.parent)


def list_video_rows(
    entries: Iterable[Dict[str, Any]], quality: str, strict: bool, cache_dir: Path, scene_map: Dict[str, str]
) -> List[Tuple[str, str, str, str, str]]:
    rows: List[Tuple[str, str, str, str, str]] = []
    for entry in entries:
        selected = select_variant(entry, quality, strict)
        cached = "0"
        if selected is not None:
            try:
                cached = "1" if (cache_dir / filename_for_url(selected[1])).exists() else "0"
            except ValueError:
                cached = "0"
        rows.append(
            (
                entry_id(entry),
                resolve_scene(entry, scene_map),
                entry_label(entry),
                "1" if isinstance(entry.get("url-1080-H264"), str) and entry.get("url-1080-H264") else "0",
                cached,
            )
        )
    return rows


def parse_limit(raw: str) -> int:
    try:
        value = int(raw)
    except (TypeError, ValueError):
        return 0
    return max(value, 0)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Fetch Apple Aerial videos and write an mpv playlist.")
    parser.add_argument("--config", help="KEY=VALUE config file to read before environment overrides")
    parser.add_argument("--quality", choices=sorted(QUALITY_KEYS))
    parser.add_argument("--source")
    parser.add_argument("--manifest-url")
    parser.add_argument("--cache-dir")
    parser.add_argument("--playlist")
    parser.add_argument("--limit", type=int)
    parser.add_argument("--scenes", help="comma-separated scenes to include")
    parser.add_argument("--hidden-videos", help="comma-separated asset IDs to hide")
    parser.add_argument(
        "--strict-quality",
        action=argparse.BooleanOptionalAction,
        default=None,
        help="only use the exact quality variant; never fall back to another codec (for Pi 3 use 1080-h264). --no-strict-quality overrides a config/env setting",
    )
    parser.add_argument("--dry-run", action="store_true", help="print selected URLs without writing files")
    parser.add_argument("--print-manifest", action="store_true", help="fetch manifest and print entry count")
    parser.add_argument("--list-videos", action="store_true", help="print id, scene, label, H264 and cache status as TSV")
    return parser


def main(argv: Optional[List[str]] = None) -> int:
    args = build_parser().parse_args(argv)
    cfg = merged_config(args)
    limit = parse_limit(cfg["AERIAL_VIDEO_LIMIT"])
    strict = is_truthy(cfg["AERIAL_STRICT_QUALITY"])
    scene_map = load_scene_map()
    manifest_url = resolve_manifest_url(cfg["AERIAL_SOURCE"], cfg["AERIAL_MANIFEST_URL"])

    try:
        entries, source = load_manifest(manifest_url, cfg["AERIAL_SOURCE"])
        selected_entries = select_entries(
            filter_entries(entries, cfg["AERIAL_SCENES"], cfg["AERIAL_HIDDEN_VIDEOS"], scene_map),
            cfg["AERIAL_QUALITY"],
            limit,
            strict,
        )
        urls = [url for _, url in selected_entries]
    except Exception as exc:  # noqa: BLE001 - CLI reports any configuration/manifest issue.
        log(str(exc))
        return 2

    if args.list_videos:
        for row in list_video_rows(entries, cfg["AERIAL_QUALITY"], strict, Path(cfg["AERIAL_CACHE_DIR"]), scene_map):
            print("\t".join(tsv_field(field) for field in row))
        return 0

    if strict and limit == 0 and len(urls) < len(filter_entries(entries, cfg["AERIAL_SCENES"], cfg["AERIAL_HIDDEN_VIDEOS"], scene_map)):
        log(
            f"strict quality {cfg['AERIAL_QUALITY']}: {len(urls)} of {len(entries)} entries have that variant"
        )

    if args.print_manifest:
        print(f"{len(entries)} entries from {source}")
        return 0

    if args.dry_run:
        for url in urls:
            print(url)
        return 0 if urls else 1

    cache_dir = Path(cfg["AERIAL_CACHE_DIR"])
    playlist = Path(cfg["AERIAL_PLAYLIST"])
    cache_dir.mkdir(parents=True, exist_ok=True)
    poi_strings = load_poi_strings()

    available: List[Path] = []
    label_rows: List[Tuple[str, str, str, str, str, str]] = []
    label_json_rows: List[Dict[str, Any]] = []
    for index, (entry, url) in enumerate(selected_entries, 1):
        log(f"[{index}/{len(urls)}] {url}")
        path = download_one(url, cache_dir)
        if path is not None and path.exists() and path.stat().st_size > 0:
            label = entry_label(entry)
            asset_id = entry_id(entry)
            scene = resolve_scene(entry, scene_map)
            name = entry_name(entry)
            available.append(path)
            label_rows.append(
                (
                    path.name,
                    label,
                    asset_id,
                    scene,
                    name,
                    entry_poi_json(entry),
                )
            )
            label_json_rows.append(
                {
                    "file": path.name,
                    "label": label,
                    "accessibilityLabel": label,
                    "id": asset_id,
                    "scene": scene,
                    "name": name,
                    "pointsOfInterest": entry_poi_rows(entry, poi_strings),
                }
            )

    if not available:
        log("no videos available; playlist was not written")
        return 1

    write_playlist(available, playlist)
    write_labels(label_rows, playlist.parent / "labels.tsv")
    write_labels_json(label_json_rows, playlist.parent / "labels.json")
    log(f"wrote playlist {playlist} with {len(available)} videos")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
